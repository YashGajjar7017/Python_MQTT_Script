    def clear_recv_stream():
        txt_recv_stream.delete("1.0", tk.END)

    btn_clear_recv = ttk.Button(f_recv_stream_frame, text="Clear Stream", command=clear_recv_stream)
    btn_clear_recv.pack(side=tk.RIGHT, pady=1)

    # -------------------------------------------------------------------------
    # TOPIC EDIT POPUP DIALOG (DOUBLE-CLICK ON TREE_SUB) (REQ 4)
    # -------------------------------------------------------------------------
    def on_sub_double_click(event=None):
        sel = tree_sub.selection()
        if not sel:
            return
        item_id = sel[0]
        item_vals = tree_sub.item(item_id, "values")
        if not item_vals:
            return
        old_top = str(item_vals[0])
        old_qos = str(item_vals[1])
        open_edit_topic_dialog(old_top, old_qos)

    def open_edit_topic_dialog(old_topic, old_qos="0"):
        dialog = tk.Toplevel(root)
        dialog.title("Edit Subscribed Topic")
        dialog.geometry("520x220")
        dialog.resizable(False, False)
        dialog.transient(root)
        dialog.grab_set()

        try:
            x = root.winfo_x() + (root.winfo_width() // 2) - 260
            y = root.winfo_y() + (root.winfo_height() // 2) - 110
            dialog.geometry(f"+{x}+{y}")
        except Exception:
            pass

        ttk.Label(dialog, text="Edit MQTT Subscribed Topic Filter:", font=("Segoe UI", 9, "bold")).pack(anchor=tk.W, padx=15, pady=(15, 4))

        f_entry = ttk.Frame(dialog)
        f_entry.pack(fill=tk.X, padx=15, pady=4)
        entry_edit_topic = ttk.Entry(f_entry, font=("Consolas", 9))
        entry_edit_topic.insert(0, old_topic)
        entry_edit_topic.pack(fill=tk.X, expand=True)

        f_qos = ttk.Frame(dialog)
        f_qos.pack(fill=tk.X, padx=15, pady=6)
        ttk.Label(f_qos, text="QoS Level:").pack(side=tk.LEFT, padx=(0, 5))
        combo_edit_qos = ttk.Combobox(f_qos, values=["0", "1", "2"], width=4, state="readonly")
        combo_edit_qos.set(str(old_qos) if str(old_qos) in ["0", "1", "2"] else "0")
        combo_edit_qos.pack(side=tk.LEFT)

        lbl_dlg_err = ttk.Label(dialog, text="", foreground="red", font=("Segoe UI", 8))
        lbl_dlg_err.pack(anchor=tk.W, padx=15, pady=2)

        def save_and_resubscribe():
            new_topic = entry_edit_topic.get().strip()
            if not new_topic:
                lbl_dlg_err.config(text="Topic cannot be empty!")
                return
            new_qos = int(combo_edit_qos.get() or 0)

            if active_client and is_connected and old_topic:
                try:
                    active_client.unsubscribe(old_topic)
                except Exception:
                    pass
            if old_topic in subscribed_topics_map:
                del subscribed_topics_map[old_topic]

            subscribed_topics_map[new_topic] = {"qos": new_qos, "packets": 0, "status": "Subscribed"}
            if active_client and is_connected:
                try:
                    active_client.subscribe(new_topic, qos=new_qos)
                except Exception:
                    pass

            refresh_sub_treeview()
            sync_and_save_state()
            dialog.destroy()
            log_to_console(f"[TOPIC UPDATED] Subscribed topic edited from '{old_topic}' to '{new_topic}' (QoS {new_qos})")
            log_topic_started_box(new_topic, action=f"RE-SUBSCRIBE (Edited from '{old_topic}')", extra=f"QoS: {new_qos}")

        f_dlg_btns = ttk.Frame(dialog)
        f_dlg_btns.pack(fill=tk.X, padx=15, pady=(10, 10))

        btn_save = tk.Button(
            f_dlg_btns,
            text="✔ Save & Re-Subscribe",
            command=save_and_resubscribe,
            font=("Segoe UI", 9, "bold"),
            bg="#28a745",
            fg="white",
            padx=10,
            pady=3
        )
        btn_save.pack(side=tk.RIGHT, padx=5)

        btn_cancel = ttk.Button(f_dlg_btns, text="Cancel", command=dialog.destroy)
        btn_cancel.pack(side=tk.RIGHT, padx=5)

    tree_sub.bind("<Double-1>", on_sub_double_click)

    # -------------------------------------------------------------------------
    # SELECTION & DISPATCH LOGIC FOR REGISTERS
    # -------------------------------------------------------------------------
    def update_selection_state():
        selected = tree_regs.selection()
        cnt = len(selected)
        lbl_selection_count.config(text=f"{cnt} registers selected for batch")
        if 'lbl_wifi_selection_count' in locals():
            lbl_wifi_selection_count.config(text=f"{cnt} registers selected for batch")
        if cnt == 1:
            item = tree_regs.item(selected[0]) if tree_regs.exists(selected[0]) else (tree_wifi_regs.item(selected[0]) if ('tree_wifi_regs' in locals() and tree_wifi_regs is not None and tree_wifi_regs.exists(selected[0])) else {})
            vals = item.get("values", [])
            if vals:
                r_addr = str(vals[0])
                r_name = str(vals[1])
                entry_reg_num_dyn.delete(0, tk.END)
                entry_reg_num_dyn.insert(0, r_addr)
                lbl_reg_name_hint.config(text=f"[{r_name}]")
                if 'entry_wifi_reg_num_dyn' in locals():
                    entry_wifi_reg_num_dyn.delete(0, tk.END)
                    entry_wifi_reg_num_dyn.insert(0, r_addr)
                    lbl_wifi_reg_name_hint.config(text=f"[{r_name}]")
        elif cnt > 1:
            lbl_reg_name_hint.config(text=f"[Batch of {cnt} registers]")
        update_payload_preview()

    def on_tree_select(event=None):
        update_selection_state()

    tree_regs.bind("<<TreeviewSelect>>", on_tree_select)
    tree_regs.bind("<ButtonRelease-1>", on_tree_select)
    tree_regs.bind("<KeyRelease-Up>", on_tree_select)
    tree_regs.bind("<KeyRelease-Down>", on_tree_select)
    tree_regs.bind("<Double-1>", lambda e: dispatch_immediate_fetch())

    def on_reg_num_typed(event=None):
        val = entry_reg_num_dyn.get().strip()
        try:
            addr = int(val)
            if addr in REGISTER_CACHE:
                lbl_reg_name_hint.config(text=f"[{REGISTER_CACHE[addr]['name']}]")
                target_iid = None
                if tree_regs.exists(str(addr)):
                    target_iid = str(addr)
                else:
                    for ch in tree_regs.get_children():
                        vals = tree_regs.item(ch).get("values", [])
                        if vals and str(vals[0]) == str(addr):
                            target_iid = ch
                            break
                if target_iid:
                    tree_regs.selection_set(target_iid)
                    tree_regs.focus(target_iid)
                    tree_regs.see(target_iid)
            else:
                lbl_reg_name_hint.config(text="[Custom Register]")
        except ValueError:
            lbl_reg_name_hint.config(text="[Invalid Addr]")
        update_payload_preview()

    entry_reg_num_dyn.bind("<KeyRelease>", on_reg_num_typed)

    def get_selected_registers_dict():
        """Returns dictionary of {REG_NUMBER: VAL} for currently selected registers."""
        selected = tree_regs.selection()
        if not selected:
            selected = tree_regs.get_children()
        batch_dict = {}
        def_val_raw = entry_reg_val_dyn.get().strip() or "0"
        def_val = int(def_val_raw) if def_val_raw.isdigit() else def_val_raw

        for item_id in selected:
            item = tree_regs.item(item_id)
            vals = item.get("values", [])
            if len(vals) >= 2:
                r_addr = str(vals[0])
                batch_dict[r_addr] = def_val
        return batch_dict

    def update_payload_preview(*args):
        selected = tree_regs.selection()
        cm = entry_cmkey_dyn.get().strip() or LIVE_KEYS.get("CMKEY", "155521")
        pm = entry_pmkey_dyn.get().strip() or LIVE_KEYS.get("PMKEY", "438266")
        cmd_val = combo_cmd_dyn.get().strip() or "read"

        if len(selected) > 1:
            batch_dict = get_selected_registers_dict()
            payload_obj = build_ondemand_payload(batch_dict=batch_dict, cmkey=cm, pmkey=pm, cmd=cmd_val)
        else:
            r_num = entry_reg_num_dyn.get().strip() or "3355"
            r_val_raw = entry_reg_val_dyn.get().strip() or "0"
            r_val = int(r_val_raw) if r_val_raw.isdigit() else r_val_raw
            payload_obj = build_ondemand_payload(r_num, r_val, cmkey=cm, pmkey=pm, cmd=cmd_val)

        p_str = json.dumps(payload_obj)
        if len(p_str) > 140:
            preview_disp = p_str[:135] + f"... [+{len(p_str)-135} chars]"
        else:
            preview_disp = p_str
        lbl_payload_preview.config(text=f"Payload: {preview_disp}")
        if 'lbl_wifi_payload_preview' in locals():
            lbl_wifi_payload_preview.config(text=f"Payload: {preview_disp}")
        return payload_obj

    # Key bindings for preview updates
    entry_reg_val_dyn.bind("<KeyRelease>", update_payload_preview)
    entry_cmkey_dyn.bind("<KeyRelease>", update_payload_preview)
    entry_pmkey_dyn.bind("<KeyRelease>", update_payload_preview)
    combo_cmd_dyn.bind("<<ComboboxSelected>>", update_payload_preview)

    def dispatch_wifi_fetch(batch=False):
        """Dispatches ondemand register query directly to the Local WiFi device."""
        w_ip = saved_state.get("wifi_device_ip", "192.168.4.1")
        w_port = saved_state.get("wifi_device_port", 80)
        w_proto = saved_state.get("wifi_protocol", "HTTP POST (/ondemand)")
        try:
            if 'entry_wifi_ip' in locals():
                w_ip = entry_wifi_ip.get().strip() or w_ip
            if 'entry_wifi_port' in locals():
                w_port = int(entry_wifi_port.get().strip() or w_port)
            if 'combo_wifi_proto' in locals():
                w_proto = combo_wifi_proto.get().strip() or w_proto
        except Exception:
            pass

        cm = entry_cmkey_dyn.get().strip() or LIVE_KEYS.get("CMKEY", "155521")
        pm = entry_pmkey_dyn.get().strip() or LIVE_KEYS.get("PMKEY", "438266")
        cmd_val = combo_cmd_dyn.get().strip() or "read"

        if batch:
            batch_dict = get_selected_registers_dict()
            if not batch_dict:
                messagebox.showinfo("Batch Selection", "No registers found in the current view to batch.")
                return
            payload_obj = build_ondemand_payload(batch_dict=batch_dict, cmkey=cm, pmkey=pm, cmd=cmd_val)
            desc = f"Batch of {len(batch_dict)} registers"
        else:
            r_num = entry_reg_num_dyn.get().strip() or "3355"
            r_val_raw = entry_reg_val_dyn.get().strip() or "0"
            r_val = int(r_val_raw) if r_val_raw.isdigit() else r_val_raw
            payload_obj = build_ondemand_payload(r_num, r_val, cmkey=cm, pmkey=pm, cmd=cmd_val)
            desc = f"Register [{r_num}] = {r_val}"

        payload_json = json.dumps(payload_obj)
        target_top = f"WiFi://{w_ip}:{w_port}/ondemand"
        now_str = datetime.now().strftime("%H:%M:%S")

        lbl_fetch_status.config(
            text=f"[📶 WiFi Query] Contacting local device at {w_ip}:{w_port}... Waiting for response...",
            fg="#e65100"
        )
        log_transmission("SENT", target_top, payload_json, extra=desc)
        log_topic_started_box(target_top, action="LOCAL WIFI QUERY", payload=payload_json, extra=desc)

        w_unit_id = 1
        w_zero_based = True
        try:
            if 'entry_wifi_unit_id' in locals():
                w_unit_id = int(entry_wifi_unit_id.get().strip() or 1)
            if 'var_wifi_zero_based' in locals():
                w_zero_based = var_wifi_zero_based.get()
        except Exception:
            pass

        def wifi_worker():
            success, resp_data, raw_resp, rtt_ms, err, trace_log = query_local_wifi_device(
                w_ip, w_port, w_proto, payload_obj, unit_id=w_unit_id, zero_based=w_zero_based
            )
            now_utc = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")

            def on_finish():
                if 'txt_wifi_console' in locals():
                    log_wifi_console(trace_log + "\n")
                if success:
                    log_transmission("RECV", target_top, raw_resp or json.dumps(resp_data), latency=rtt_ms, extra=f"Modbus/HTTP OK | RTT: {rtt_ms} ms")
                    log_topic_completed_box(target_top, rtt_ms=rtt_ms, payload=raw_resp, extra=f"Device {w_ip} replied successfully")
                    if 'lbl_wifi_recv_info' in locals():
                        lbl_wifi_recv_info.config(text=f"Status: OK (RTT: {rtt_ms} ms) | {w_proto}", fg="#2e7d32")
                    if 'lbl_wifi_recv_payload' in locals():
                        lbl_wifi_recv_payload.config(text=f"Data: {resp_data}")
                    # Update REGISTER_CACHE with received registers
                    if resp_data:
                        updated_cnt = update_registers_table(resp_data, now_utc)
                    else:
                        sim_data = {str(k): 1 for k in (batch_dict if batch else [r_num])}
                        updated_cnt = update_registers_table(sim_data, now_utc)
                    lbl_fetch_status.config(
                        text=f"[✓ WiFi Success] Received response from {w_ip}:{w_port} (RTT: {rtt_ms} ms)! Updated {updated_cnt} registers.",
                        fg="#1b5e20"
                    )
                else:
                    err_msg = f"Device at {w_ip}:{w_port} offline: {err or 'Timeout'}"
                    log_transmission("ERR", target_top, err_msg, latency=rtt_ms)
                    if 'lbl_wifi_recv_info' in locals():
                        lbl_wifi_recv_info.config(text=f"Status: Error | {err_msg}", fg="#c62828")
                    lbl_fetch_status.config(text=f"[✗ WiFi Device Offline] {err_msg}", fg="#c62828")
                    sim_ans = messagebox.askyesno(
                        "WiFi Device Unreachable",
                        f"Could not reach WiFi device at {w_ip}:{w_port} ({err}).\n\nSimulate successful response for testing register values?"
                    )
                    if sim_ans:
                        sim_data = {str(k): 1 for k in (batch_dict if batch else [r_num])}
                        updated_cnt = update_registers_table(sim_data, now_utc)
                        lbl_fetch_status.config(
                            text=f"[✓ Simulated WiFi] Updated {updated_cnt} registers locally for {w_ip}!",
                            fg="#1b5e20"
                        )
                sync_and_save_state()

            root.after(0, on_finish)

        threading.Thread(target=wifi_worker, daemon=True).start()

    def dispatch_immediate_fetch():
        """Dispatches single register ondemand query with format 'REG_NUMBER': 'VAL'."""
        nonlocal active_client, is_connected, last_dispatch_meta
        if var_transport_mode.get() == "wifi":
            dispatch_wifi_fetch(batch=False)
            return

        if not is_connected or not active_client:
            messagebox.showwarning("Connection", "Please connect to the MQTT broker first using the 'Connect' button above.")
            return

        top = entry_pub_topic_tab1.get().strip() or f"rtsg-1/ongridrooftop/{entry_imei_dyn.get().strip()}/ondemand/sub"

        r_num = entry_reg_num_dyn.get().strip() or "3355"
        r_val_raw = entry_reg_val_dyn.get().strip() or "0"
        r_val = int(r_val_raw) if r_val_raw.isdigit() else r_val_raw
        cm = entry_cmkey_dyn.get().strip() or LIVE_KEYS.get("CMKEY", "155521")
        pm = entry_pmkey_dyn.get().strip() or LIVE_KEYS.get("PMKEY", "438266")
        cmd_val = combo_cmd_dyn.get().strip() or "read"

        payload_obj = build_ondemand_payload(r_num, r_val, cmkey=cm, pmkey=pm, cmd=cmd_val)
        payload_json = json.dumps(payload_obj)

        now_str = datetime.now().strftime("%H:%M:%S")
        last_dispatch_meta = {
            "topic": top,
            "payload": payload_json,
            "time": time.time(),
            "time_str": now_str
        }

        active_client.publish(top, payload_json, qos=0)
        log_transmission("SENT", top, payload_json)
        log_topic_started_box(top, action="ONDEMAND SINGLE QUERY", payload=payload_json, extra=f"Register [{r_num}] = {r_val}")

        lbl_fetch_status.config(
            text=f"[✓] Dispatched ondemand '{r_num}': {r_val} to '{top}' at {now_str}! Awaiting response...",
            fg="#2e7d32"
        )
        sync_and_save_state()

    def dispatch_batch_payload():
        """Dispatches batch payload containing all selected registers with format 'REG_NUMBER': 'VAL'."""
        nonlocal active_client, is_connected, last_dispatch_meta
        if var_transport_mode.get() == "wifi":
            dispatch_wifi_fetch(batch=True)
            return

        if not is_connected or not active_client:
            messagebox.showwarning("Connection", "Please connect to the MQTT broker first using the 'Connect' button above.")
            return

        top = entry_pub_topic_tab1.get().strip() or f"rtsg-1/ongridrooftop/{entry_imei_dyn.get().strip()}/ondemand/sub"

        batch_dict = get_selected_registers_dict()
        if not batch_dict:
            messagebox.showinfo("Batch Selection", "No registers found in the current view to batch.")
            return

        cm = entry_cmkey_dyn.get().strip() or LIVE_KEYS.get("CMKEY", "155521")
        pm = entry_pmkey_dyn.get().strip() or LIVE_KEYS.get("PMKEY", "438266")
        cmd_val = combo_cmd_dyn.get().strip() or "read"

        payload_obj = build_ondemand_payload(batch_dict=batch_dict, cmkey=cm, pmkey=pm, cmd=cmd_val)
        payload_json = json.dumps(payload_obj)

        now_str = datetime.now().strftime("%H:%M:%S")
        last_dispatch_meta = {
            "topic": top,
            "payload": payload_json,
            "time": time.time(),
            "time_str": now_str
        }

        active_client.publish(top, payload_json, qos=0)
        log_transmission("SENT", top, payload_json, extra=f"Batch of {len(batch_dict)} registers ('REG_NUMBER': 'VAL')")
        log_topic_started_box(top, action="ONDEMAND BATCH QUERY", payload=payload_json, extra=f"Batch of {len(batch_dict)} registers")

        lbl_fetch_status.config(
            text=f"[✓] Dispatched batch payload with {len(batch_dict)} registers to '{top}' at {now_str}! Waiting for response...",
            fg="#1565c0"
        )
        sync_and_save_state()

    # Filter & Search Engine with Modern Multi-Section Match Badges
    def apply_filter_regs(*args):
        query = entry_reg_search.get().strip().upper()
        sec = current_section.get()
        search_all = var_search_all.get()

        overall_matches, section_counts = search_across_all_sections(query)

        # Update Section Buttons with Match Count Badges on both Tab 1 and Tab 2
        for btn_dict in (sec_buttons, wifi_sec_buttons):
            for s_name, btn in btn_dict.items():
                bg_default, fg_default = section_colors.get(s_name, ("#f5f5f5", "#333"))
                is_active_sec = (s_name == sec)
                if query:
                    if s_name.startswith("8") or "ALL" in s_name.upper():
                        s_count = len(overall_matches)
                    else:
                        s_count = section_counts.get(s_name, 0)
                    btn.config(text=f"{s_name} ({s_count})")
                    if s_count > 0:
                        btn.config(bg="#fff9c4", fg="#f57f17", font=("Segoe UI", 9, "bold"))
                    else:
                        btn.config(bg=bg_default, fg="#9e9e9e", font=("Segoe UI", 9))
                else:
                    btn.config(text=s_name, bg=bg_default, fg=fg_default, font=("Segoe UI", 9, "bold" if is_active_sec else "normal"))

                if is_active_sec:
                    btn.config(relief=tk.SUNKEN, bd=3)
                else:
                    btn.config(relief=tk.RAISED, bd=1)

        displayed = []
        if not sec.startswith("8") and "ALL" not in sec.upper():
            displayed = [r for r in overall_matches if r["category"] == sec]
        else:
            displayed = list(overall_matches)

        displayed.sort(key=lambda x: x["address"])

        trees_to_update = [tree_regs]
        if 'tree_wifi_regs' in locals() and tree_wifi_regs is not None:
            trees_to_update.append(tree_wifi_regs)

        for tr in trees_to_update:
            for item in tr.get_children():
                tr.delete(item)

            for r in displayed:
                val = r.get("value", "---")
                ts = r.get("updated_at", "Never")
                tag = "updated" if val != "---" else "normal"
                item_iid = str(r["address"])
                if tr.exists(item_iid):
                    item_iid = f"{r['address']}_{r['name']}"
                tr.insert("", tk.END, iid=item_iid, values=(
                    r["address"],
                    r["name"],
                    r["category"],
                    val,
                    r.get("description", ""),
                    ts
                ), tags=(tag,))

            ch = tr.get_children()
            if ch:
                first_iid = ch[0]
                tr.selection_set(first_iid)
                tr.focus(first_iid)
                tr.see(first_iid)

        count_text = f"Showing {len(displayed)} registers (Total {len(overall_matches)} matching '{query}')" if query else f"Showing {len(displayed)} / {len(REGISTER_CACHE)} registers in '{sec}'"
        lbl_reg_count.config(text=count_text)
        if 'lbl_wifi_reg_count' in locals():
            lbl_wifi_reg_count.config(text=count_text)

        update_selection_state()

    entry_reg_search.bind("<KeyRelease>", apply_filter_regs)
    chk_search_all.config(command=apply_filter_regs)

    # -------------------------------------------------------------------------
    # TRANSMISSION & ACTIVITY LOGGING HELPERS
    # -------------------------------------------------------------------------
    def log_transmission(direction, topic, payload, latency=None, extra=""):
        now_ts = datetime.now().strftime("%H:%M:%S")
        if direction.upper() == "SENT":
            entry_line = f"[{now_ts}] 📤 DISPATCHED -> {topic} | Payload: {payload}"
            if extra:
                entry_line += f" ({extra})"
            lbl_pub_topic_info.config(text=f"Topic: {topic}  [{now_ts}]")
            disp_p = payload if len(payload) <= 90 else (payload[:87] + "...")
            lbl_pub_payload_info.config(text=f"Payload: {disp_p}")
            if "WiFi" in topic and 'lbl_wifi_pub_info' in locals():
                lbl_wifi_pub_info.config(text=f"Endpoint: {topic} [{now_ts}]")
                lbl_wifi_pub_payload.config(text=f"Payload: {disp_p}")
        else:
            lat_txt = f" | Latency: {latency:.1f}ms" if latency is not None else ""
            entry_line = f"[{now_ts}] 📥 RECEIVED   <- {topic}{lat_txt} | Payload: {payload}"
            if extra:
                entry_line += f" ({extra})"
            lbl_recv_topic_info.config(text=f"Topic: {topic}  [{now_ts}{lat_txt}]")
            disp_p = payload if len(payload) <= 90 else (payload[:87] + "...")
            lbl_recv_payload_info.config(text=f"Payload: {disp_p}")
            if "WiFi" in topic and 'lbl_wifi_recv_info' in locals():
                lbl_wifi_recv_info.config(text=f"Status: Received [{now_ts}{lat_txt}]")
                lbl_wifi_recv_payload.config(text=f"Data: {disp_p}")

    def log_topic_started_box(topic, action="PUBLISH", payload="", extra=""):
        now_utc = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
        items = {
            "Status": "▶ TOPIC TRANSMISSION STARTED",
            "Topic": topic,
            "Timestamp": now_utc,
            "Action": action,
        }
        if extra:
            items["Details"] = extra
        if payload:
            items["Payload"] = payload
        box_text = format_boxed_log("TRANSMISSION OUTGOING (STARTED)", items)
        log_to_console("\n" + box_text + "\n")
        print("\n" + box_text + "\n")

    def log_topic_completed_box(topic, rtt_ms=None, payload="", status="COMPLETED / RECEIVED", extra=""):
        now_utc = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
        items = {
            "Status": f"✔ TOPIC TRANSACTION {status}",
            "Topic": topic,
            "Timestamp": now_utc,
        }
        if rtt_ms is not None:
            items["Latency RTT"] = f"{rtt_ms:.1f} ms"
        if extra:
            items["Details"] = extra
        if payload:
            items["Payload"] = payload
        box_text = format_boxed_log("TRANSACTION COMPLETED / INCOMING", items)
        log_to_console("\n" + box_text + "\n")
        print("\n" + box_text + "\n")

    def update_registers_table(data_dict, now_utc):
        updated_count = 0
        if not data_dict or not isinstance(data_dict, dict):
            return 0

        # Update dynamic CMKEY & PMKEY if present in incoming packet
        cm = str(data_dict.get("CMKEY", "") or "")
        pm = str(data_dict.get("PMKEY", "") or "")
        if cm:
            LIVE_KEYS["CMKEY"] = cm
            entry_cmkey_dyn.delete(0, tk.END)
            entry_cmkey_dyn.insert(0, cm)
        if pm:
            LIVE_KEYS["PMKEY"] = pm
            entry_pmkey_dyn.delete(0, tk.END)
            entry_pmkey_dyn.insert(0, pm)

        regs_dict = data_dict.get("registers", {})
        if isinstance(regs_dict, dict):
            for reg_k, reg_v in regs_dict.items():
                try:
                    reg_addr = int(reg_k)
                    if reg_addr in REGISTER_CACHE:
                        REGISTER_CACHE[reg_addr]["value"] = str(reg_v)
                        REGISTER_CACHE[reg_addr]["updated_at"] = now_utc
                        updated_count += 1
                except (ValueError, TypeError):
                    pass

        for k, v in data_dict.items():
            # Check direct integer register address
            try:
                addr_direct = int(k)
                if addr_direct in REGISTER_CACHE:
                    REGISTER_CACHE[addr_direct]["value"] = str(v)
                    REGISTER_CACHE[addr_direct]["updated_at"] = now_utc
                    updated_count += 1
                    continue
            except (ValueError, TypeError):
                pass

            # Match by register name
            k_up = str(k).upper().replace("-", "_").replace(" ", "_")
            if k_up in NAME_TO_ADDR:
                addr = NAME_TO_ADDR[k_up]
                REGISTER_CACHE[addr]["value"] = str(v)
                REGISTER_CACHE[addr]["updated_at"] = now_utc
                updated_count += 1

        if "IS-1-0---VN" in data_dict:
            for a in (3045, 3044):
                if a in REGISTER_CACHE:
                    REGISTER_CACHE[a]["value"] = f"{data_dict['IS-1-0---VN']} V"
                    REGISTER_CACHE[a]["updated_at"] = now_utc
                    updated_count += 1
        if "IS-1-0---FREQ" in data_dict:
            for a in (3053, 3052):
                if a in REGISTER_CACHE:
                    REGISTER_CACHE[a]["value"] = f"{data_dict['IS-1-0---FREQ']} Hz"
                    REGISTER_CACHE[a]["updated_at"] = now_utc
                    updated_count += 1
        if "IS-1-0---POW" in data_dict:
            for a in (2979, 2978):
                if a in REGISTER_CACHE:
                    REGISTER_CACHE[a]["value"] = f"{data_dict['IS-1-0---POW']} W"
                    REGISTER_CACHE[a]["updated_at"] = now_utc
                    updated_count += 1
        if "CMKEY" in data_dict:
            for a in (3555, 3554):
                if a in REGISTER_CACHE:
                    REGISTER_CACHE[a]["value"] = str(data_dict["CMKEY"])
                    REGISTER_CACHE[a]["updated_at"] = now_utc
                    updated_count += 1

        apply_filter_regs()
        update_payload_preview()
        if updated_count > 0:
            lbl_fetch_status.config(
                text=f"[✓] Success: Received device response! Updated {updated_count} register values at {now_utc} UTC",
                fg="#1b5e20"
            )
        sync_and_save_state()
        return updated_count

    # -------------------------------------------------------------------------
    # SUBSCRIPTION MANAGER HANDLERS (TREE_SUB)
    # -------------------------------------------------------------------------
    def refresh_sub_treeview():
        for item in tree_sub.get_children():
            tree_sub.delete(item)
        for top, info in subscribed_topics_map.items():
            tree_sub.insert("", tk.END, iid=top, values=(
                top,
                info.get("qos", 0),
                info.get("packets", 0),
                info.get("status", "Active")
            ))

    def add_custom_subscription(topic_to_sub=None):
        nonlocal active_client
        target_top = (topic_to_sub or entry_sub_topic_tab1.get()).strip()
        if not target_top:
            messagebox.showwarning("Topic", "Please enter a valid MQTT topic to subscribe.")
            return
        qos_val = int(combo_sub_qos.get() or 0)
        subscribed_topics_map[target_top] = {"qos": qos_val, "packets": 0, "status": "Subscribed"}
        if active_client and is_connected:
            try:
                active_client.subscribe(target_top, qos=qos_val)
            except Exception:
                pass
        refresh_sub_treeview()
        lbl_sub_status.config(text=f"[✓] Subscribed to '{target_top}' (QoS {qos_val})", fg="#1b5e20")
        sync_and_save_state()

    def remove_subscription():
        nonlocal active_client
        sel = tree_sub.selection()
        if not sel:
            return
        top = sel[0]
        if active_client and is_connected:
            active_client.unsubscribe(top)
        if top in subscribed_topics_map:
            del subscribed_topics_map[top]
        refresh_sub_treeview()
        lbl_sub_status.config(text=f"[-] Unsubscribed from '{top}'", fg="#b71c1c")
        sync_and_save_state()

    def set_dynamic_imei_topics(target_imei):
        nonlocal active_client
        if not target_imei:
            return
        # Synchronize Target IMEI and Sub IMEI entry widgets
        if 'entry_imei_dyn' in locals() and entry_imei_dyn.get().strip() != target_imei:
            entry_imei_dyn.delete(0, tk.END)
            entry_imei_dyn.insert(0, target_imei)
        if 'entry_sub_imei_dyn' in locals() and entry_sub_imei_dyn.get().strip() != target_imei:
            entry_sub_imei_dyn.delete(0, tk.END)
            entry_sub_imei_dyn.insert(0, target_imei)
        if 'entry_pub_topic_tab1' in locals():
            entry_pub_topic_tab1.delete(0, tk.END)
            entry_pub_topic_tab1.insert(0, f"rtsg-1/ongridrooftop/{target_imei}/ondemand/sub")
        if 'entry_sub_topic_tab1' in locals():
            entry_sub_topic_tab1.delete(0, tk.END)
            entry_sub_topic_tab1.insert(0, f"rtsg-1/ongridrooftop/{target_imei}/#")

        # Unsubscribe previous topics from broker if connected
        if active_client and is_connected:
            for old_t in list(subscribed_topics_map.keys()):
                try:
                    active_client.unsubscribe(old_t)
                except Exception:
                    pass

        # Wipe out any and all topics from other IMEIs completely
        subscribed_topics_map.clear()

        # Build clean dynamic topics ONLY for the current active IMEI
        all_target_topics = [
            f"rtsg-1/ongridrooftop/{target_imei}/#",
            f"rtsg-1/ongridrooftop/{target_imei}/ondemand/pub",
            f"rtsg-1/ongridrooftop/{target_imei}/data/pub",
            f"rtsg-1/ongridrooftop/{target_imei}/messagekey/sub",
            f"rtsg-1/ongridrooftop/{target_imei}/config/pub",
            f"rtsg-1/ongridrooftop/{target_imei}/rtevent/pub",
            f"rtsg-1/ongridrooftop/{target_imei}/heartbeat/pub",
            f"rtsg-1/ongridrooftop/{target_imei}/info/sub"
        ]
        for t in all_target_topics:
            subscribed_topics_map[t] = {"qos": 0, "packets": 0, "status": "Subscribed"}
            if active_client and is_connected:
                try:
                    active_client.subscribe(t, qos=0)
                except Exception:
                    pass

        refresh_sub_treeview()
        if 'lbl_sub_status' in locals():
            lbl_sub_status.config(text=f"[✓] Dynamic Topic Filter updated for IMEI: {target_imei}", fg="#0d47a1")
        try:
            sync_and_save_state()
        except (NameError, UnboundLocalError):
            pass

    def do_auto_subscribe_all():
        target_imei = entry_imei_dyn.get().strip() or broker_cfg.get("name", "866738083623411")
        set_dynamic_imei_topics(target_imei)

    btn_auto_sub.config(command=do_auto_subscribe_all)

    # Initialize dynamic subscriptions for current active IMEI ONLY (removes all other IMEIs)
    cur_init_imei = entry_imei_dyn.get().strip() or init_imei
    set_dynamic_imei_topics(cur_init_imei)

    # -------------------------------------------------------------------------
    # TAB 2: LOCAL WIFI STATION (DEVICE DIRECT MODBUS & ONDEMAND FETCH)
    # -------------------------------------------------------------------------
    tab_wifi = ttk.Frame(notebook)
    notebook.add(tab_wifi, text="  📶 Local WiFi Station  ")

    # =========================================================================
    # CONTAINER 1: TOP FULL-WIDTH REGISTER SEARCHBAR & SECTION SELECTOR (WIFI)
    # =========================================================================
    f_wifi_top_container = ttk.LabelFrame(tab_wifi, text="1. Register Search Engine & Section Selector (Local WiFi Station)", padding=6)
    f_wifi_top_container.pack(fill=tk.X, padx=8, pady=(2, 4))

    sec_btn_frame_wifi = ttk.Frame(f_wifi_top_container)
    sec_btn_frame_wifi.pack(fill=tk.X, pady=1)

    for sec in SECTIONS:
        bg_col, fg_col = section_colors.get(sec, ("#f5f5f5", "#333"))
        is_cur = (sec == current_section.get())
        b = tk.Button(
            sec_btn_frame_wifi,
            text=sec,
            command=lambda s=sec: switch_section(s),
            bg=bg_col,
            fg=fg_col,
            font=("Segoe UI", 9, "bold" if is_cur else "normal"),
            relief=tk.SUNKEN if is_cur else tk.RAISED,
            bd=3 if is_cur else 1,
            padx=5,
            pady=2
        )
        b.pack(side=tk.LEFT, padx=2, pady=1)
        wifi_sec_buttons[sec] = b

    # Search & Filter Toolbar for WiFi Tab
    f_wifi_search = ttk.Frame(f_wifi_top_container)
    f_wifi_search.pack(fill=tk.X, pady=(3, 1))

    ttk.Label(f_wifi_search, text="🔍 Search Registers (Name/Addr/Function):", font=("Segoe UI", 9, "bold")).pack(side=tk.LEFT, padx=(2, 6))
    entry_wifi_reg_search = ttk.Entry(f_wifi_search, width=24, font=("Segoe UI", 9))
    entry_wifi_reg_search.insert(0, saved_state.get("search_query", ""))
    entry_wifi_reg_search.pack(side=tk.LEFT, padx=3)

    chk_wifi_search_all = ttk.Checkbutton(f_wifi_search, text="Search Across All Sections (Show Badges)", variable=var_search_all)
    chk_wifi_search_all.pack(side=tk.LEFT, padx=6)

    def sync_search_wifi_to_main(*args):
        q = entry_wifi_reg_search.get()
        entry_reg_search.delete(0, tk.END)
        entry_reg_search.insert(0, q)
        apply_filter_regs()

    entry_wifi_reg_search.bind("<KeyRelease>", sync_search_wifi_to_main)
    chk_wifi_search_all.config(command=apply_filter_regs)

    btn_wifi_clear_s = ttk.Button(f_wifi_search, text="Clear Search", command=lambda: (entry_wifi_reg_search.delete(0, tk.END), clear_search()))
    btn_wifi_clear_s.pack(side=tk.LEFT, padx=3)

    lbl_wifi_reg_count = ttk.Label(f_wifi_search, text="Showing 0 registers", font=("Segoe UI", 9, "italic"))
    lbl_wifi_reg_count.pack(side=tk.RIGHT, padx=8)

    # =========================================================================
    # MAIN HORIZONTAL SPLIT (CONTAINER 2 LEFT ⇄ CONTAINER 3 RIGHT)
    # =========================================================================
    paned_wifi = ttk.PanedWindow(tab_wifi, orient=tk.HORIZONTAL)
    paned_wifi.pack(fill=tk.BOTH, expand=True, padx=8, pady=(2, 4))

    # =========================================================================
    # LEFT CONTAINER: WIFI CONNECTION SETTINGS & DIAGNOSTICS STREAM
    # =========================================================================
    f_wifi_left = ttk.LabelFrame(paned_wifi, text="2. Local Device WiFi Connection & Diagnostics", padding=8)
    paned_wifi.add(f_wifi_left, weight=2)

    ttk.Label(f_wifi_left, text="Local Device IP Address:", font=("Segoe UI", 9, "bold")).pack(anchor=tk.W, pady=(2, 1))
    f_wifi_ip_row = ttk.Frame(f_wifi_left)
    f_wifi_ip_row.pack(fill=tk.X, pady=(0, 4))
    entry_wifi_ip = ttk.Entry(f_wifi_ip_row, font=("Consolas", 9, "bold"), width=16)
    entry_wifi_ip.insert(0, saved_state.get("wifi_device_ip", "192.168.4.1"))
    entry_wifi_ip.pack(side=tk.LEFT, padx=(0, 4))

    def set_wifi_preset(ip_val, port_val=502):
        entry_wifi_ip.delete(0, tk.END)
        entry_wifi_ip.insert(0, ip_val)
        entry_wifi_port.delete(0, tk.END)
        entry_wifi_port.insert(0, str(port_val))

    btn_pre1 = ttk.Button(f_wifi_ip_row, text="192.168.4.1 (AP)", command=lambda: set_wifi_preset("192.168.4.1", 502))
    btn_pre1.pack(side=tk.LEFT, padx=1)
    btn_pre2 = ttk.Button(f_wifi_ip_row, text="192.168.1.100", command=lambda: set_wifi_preset("192.168.1.100", 502))
    btn_pre2.pack(side=tk.LEFT, padx=1)
    btn_pre3 = ttk.Button(f_wifi_ip_row, text="127.0.0.1 (Local)", command=lambda: set_wifi_preset("127.0.0.1", 502))
    btn_pre3.pack(side=tk.LEFT, padx=1)

    ttk.Label(f_wifi_left, text="Port:").pack(anchor=tk.W, pady=(2, 1))
    f_wifi_port_row = ttk.Frame(f_wifi_left)
    f_wifi_port_row.pack(fill=tk.X, pady=(0, 4))
    entry_wifi_port = ttk.Entry(f_wifi_port_row, font=("Consolas", 9), width=8)
    entry_wifi_port.insert(0, str(saved_state.get("wifi_device_port", 502)))
    entry_wifi_port.pack(side=tk.LEFT, padx=(0, 4))

    ttk.Button(f_wifi_port_row, text="502 (Modbus)", command=lambda: (entry_wifi_port.delete(0, tk.END), entry_wifi_port.insert(0, "502"))).pack(side=tk.LEFT, padx=1)
    ttk.Button(f_wifi_port_row, text="Port 80", command=lambda: (entry_wifi_port.delete(0, tk.END), entry_wifi_port.insert(0, "80"))).pack(side=tk.LEFT, padx=1)
    ttk.Button(f_wifi_port_row, text="Port 8080", command=lambda: (entry_wifi_port.delete(0, tk.END), entry_wifi_port.insert(0, "8080"))).pack(side=tk.LEFT, padx=1)
    ttk.Button(f_wifi_port_row, text="Port 8899", command=lambda: (entry_wifi_port.delete(0, tk.END), entry_wifi_port.insert(0, "8899"))).pack(side=tk.LEFT, padx=1)

    # Unit / Slave ID & Addressing Offset
    f_wifi_unit_row = ttk.Frame(f_wifi_left)
    f_wifi_unit_row.pack(fill=tk.X, pady=(0, 4))
    ttk.Label(f_wifi_unit_row, text="Unit / Slave ID:").pack(side=tk.LEFT, padx=(0, 2))
    entry_wifi_unit_id = ttk.Entry(f_wifi_unit_row, font=("Consolas", 9, "bold"), width=5)
    entry_wifi_unit_id.insert(0, str(saved_state.get("wifi_slave_id", 1)))
    entry_wifi_unit_id.pack(side=tk.LEFT, padx=2)

    var_wifi_zero_based = tk.BooleanVar(value=saved_state.get("wifi_zero_based", True))
    chk_wifi_zero_based = ttk.Checkbutton(f_wifi_unit_row, text="0-based offset (Addr = Reg - 1)", variable=var_wifi_zero_based)
    chk_wifi_zero_based.pack(side=tk.LEFT, padx=4)

    ttk.Label(f_wifi_left, text="Transport Protocol (Modbus Poll / TCP):").pack(anchor=tk.W, pady=(2, 1))
    combo_wifi_proto = ttk.Combobox(
        f_wifi_left,
        values=[
            "Modbus TCP/IP (Port 502 - Func 03 Holding Regs)",
            "Modbus TCP/IP (Port 502 - Func 04 Input Regs)",
            "Modbus RTU over TCP (Port 502 / 8899)",
            "HTTP POST (/ondemand)",
            "HTTP GET (/ondemand)",
            "TCP Direct Socket (JSON)"
        ],
        state="readonly",
        font=("Segoe UI", 9)
    )
    combo_wifi_proto.set(saved_state.get("wifi_protocol", "Modbus TCP/IP (Port 502 - Func 03 Holding Regs)"))
    combo_wifi_proto.pack(fill=tk.X, pady=(0, 4))

    def do_probe_protocol():
        ip = entry_wifi_ip.get().strip()
        cur_p = entry_wifi_port.get().strip() or "502"
        lbl_wifi_ping_res.config(text=f"Probing {ip} across Modbus TCP, RTU, and HTTP ports...", fg="orange", bg="#fff3e0")
        log_wifi_console(f"[{datetime.now().strftime('%H:%M:%S')}] Starting Auto-Detect Probe on {ip}...\n")
        def probe_worker():
            found, proto, port, uid, rtt, msg = probe_wifi_device_protocols(ip, default_port=cur_p)
            def on_done():
                if found:
                    combo_wifi_proto.set(proto)
                    entry_wifi_port.delete(0, tk.END)
                    entry_wifi_port.insert(0, str(port))
                    entry_wifi_unit_id.delete(0, tk.END)
                    entry_wifi_unit_id.insert(0, str(uid))
                    lbl_wifi_ping_res.config(text=f"[✓] {proto} on Port {port} (Unit ID {uid}, RTT {rtt} ms)", fg="#1b5e20", bg="#e8f5e9")
                    log_wifi_console(f"[{datetime.now().strftime('%H:%M:%S')}] [✓ PROBE SUCCESS] {msg}\n")
                    messagebox.showinfo("Protocol Auto-Detected", f"Remote device responded!\n\nProtocol: {proto}\nPort: {port}\nUnit/Slave ID: {uid}\nRound-Trip Time: {rtt} ms")
                else:
                    lbl_wifi_ping_res.config(text=f"[✗] {msg}", fg="#b71c1c", bg="#ffebee")
                    log_wifi_console(f"[{datetime.now().strftime('%H:%M:%S')}] [✗ PROBE FAILED] {msg}\n")
                    messagebox.showwarning("Auto-Detect Probe", f"Could not detect active service on {ip}.\n\nEnsure WiFi device is powered on, on the same network, and listening on Port 502 / 80.")
                sync_and_save_state()
            root.after(0, on_done)
        threading.Thread(target=probe_worker, daemon=True).start()

    btn_probe_wifi = tk.Button(
        f_wifi_left,
        text="🔍 AUTO-DETECT PROTOCOL & PROBE DEVICE",
        command=do_probe_protocol,
        font=("Segoe UI", 9, "bold"),
        bg="#6a1b9a",
        fg="white",
        relief=tk.RAISED,
        bd=2,
        padx=8,
        pady=3
    )
    btn_probe_wifi.pack(fill=tk.X, pady=(2, 4))

    f_ping_btn_row = ttk.Frame(f_wifi_left)
    f_ping_btn_row.pack(fill=tk.X, pady=2)

    def do_ping_test():
        ip = entry_wifi_ip.get().strip()
        port = entry_wifi_port.get().strip() or "502"
        lbl_wifi_ping_res.config(text=f"Pinging {ip}:{port}...", fg="orange", bg="#fff3e0")
        def ping_worker():
            ok, ms, msg = ping_local_wifi_device(ip, port)
            def on_done():
                if ok:
                    lbl_wifi_ping_res.config(text=f"[✓] ONLINE! Latency: {ms} ms ({ip}:{port})", fg="#1b5e20", bg="#e8f5e9")
                    log_wifi_console(f"[{datetime.now().strftime('%H:%M:%S')}] Ping OK to {ip}:{port} - RTT: {ms} ms\n")
                else:
                    lbl_wifi_ping_res.config(text=f"[✗] OFFLINE: {msg}", fg="#b71c1c", bg="#ffebee")
                    log_wifi_console(f"[{datetime.now().strftime('%H:%M:%S')}] Ping failed to {ip}:{port} - {msg}\n")
            root.after(0, on_done)
        threading.Thread(target=ping_worker, daemon=True).start()

    btn_ping_wifi = tk.Button(
        f_ping_btn_row,
        text="📶 Ping Once",
        command=do_ping_test,
        font=("Segoe UI", 8, "bold"),
        bg="#0288d1",
        fg="white",
        padx=6,
        pady=2
    )
    btn_ping_wifi.pack(side=tk.LEFT, padx=1)

    var_auto_ping = tk.BooleanVar(value=False)

    def auto_ping_loop():
        while var_auto_ping.get():
            ip = entry_wifi_ip.get().strip()
            port = entry_wifi_port.get().strip() or "502"
            ok, ms, msg = ping_local_wifi_device(ip, port, timeout=1.5)
            now_str = datetime.now().strftime("%H:%M:%S")
            def update_badge(is_ok=ok, rtt=ms, emsg=msg, ts=now_str):
                if not var_auto_ping.get():
                    return
                if is_ok:
                    lbl_wifi_ping_res.config(text=f"🟢 ONLINE ({rtt} ms) | {ip}:{port} | {ts}", fg="#1b5e20", bg="#e8f5e9")
                else:
                    lbl_wifi_ping_res.config(text=f"🔴 OFFLINE ({emsg}) | {ip}:{port} | {ts}", fg="#b71c1c", bg="#ffebee")
            root.after(0, update_badge)
            time.sleep(2.0)

    def toggle_auto_ping():
        if var_auto_ping.get():
            threading.Thread(target=auto_ping_loop, daemon=True).start()

    chk_auto_ping = ttk.Checkbutton(f_ping_btn_row, text="Continuous Auto-Ping (every 2s)", variable=var_auto_ping, command=toggle_auto_ping)
    chk_auto_ping.pack(side=tk.LEFT, padx=4)

    lbl_wifi_ping_res = tk.Label(
        f_wifi_left,
        text="Status: Ready to connect",
        fg="#1565c0",
        bg="#e3f2fd",
        relief=tk.SOLID,
        bd=1,
        padx=6,
        pady=3,
        font=("Segoe UI", 8)
    )
    lbl_wifi_ping_res.pack(fill=tk.X, pady=(2, 4))

    ttk.Label(f_wifi_left, text="WiFi Raw Communication Stream (Modbus Analyzer):", font=("Segoe UI", 8, "bold")).pack(anchor=tk.W, pady=(4, 1))
    txt_wifi_console = scrolledtext.ScrolledText(f_wifi_left, height=14, bg="#1e1e1e", fg="#00e676", font=("Consolas", 8))
    txt_wifi_console.pack(fill=tk.BOTH, expand=True, pady=(1, 2))

    def log_wifi_console(text_msg):
        txt_wifi_console.insert(tk.END, text_msg)
        txt_wifi_console.see(tk.END)

    f_wifi_log_tools = ttk.Frame(f_wifi_left)
    f_wifi_log_tools.pack(fill=tk.X, pady=(2, 0))

    def clear_wifi_console():
        txt_wifi_console.delete("1.0", tk.END)

    def export_wifi_log():
        content = txt_wifi_console.get("1.0", tk.END)
        fn = f"wifi_modbus_log_{datetime.now().strftime('%Y%m%d_%H%M%S')}.txt"
        with open(fn, "w", encoding="utf-8") as f:
            f.write(content)
        messagebox.showinfo("Export Log", f"Modbus WiFi packet log saved to:\n{fn}")

    def copy_wifi_log():
        root.clipboard_clear()
        root.clipboard_append(txt_wifi_console.get("1.0", tk.END))
        messagebox.showinfo("Copied", "Log contents copied to clipboard!")

    ttk.Button(f_wifi_log_tools, text="Clear Stream", command=clear_wifi_console).pack(side=tk.LEFT, padx=1)
    ttk.Button(f_wifi_log_tools, text="💾 Export Log", command=export_wifi_log).pack(side=tk.LEFT, padx=1)
    ttk.Button(f_wifi_log_tools, text="📋 Copy All", command=copy_wifi_log).pack(side=tk.LEFT, padx=1)

    # =========================================================================
    # RIGHT CONTAINER: FULL SYNCHRONIZED REGISTER EXPLORER & DISPATCHER
    # =========================================================================
    f_wifi_right = ttk.LabelFrame(paned_wifi, text="3. Local Device Register Selector & Ondemand Dispatcher", padding=6)
    paned_wifi.add(f_wifi_right, weight=5)

    # Register Table (Treeview) for WiFi Tab
    reg_table_frame_wf = ttk.Frame(f_wifi_right)
    reg_table_frame_wf.pack(fill=tk.BOTH, expand=True, pady=2)

    tree_wifi_regs = ttk.Treeview(reg_table_frame_wf, columns=reg_cols, show="headings", selectmode="extended")

    for col in reg_cols:
        tree_wifi_regs.heading(col, text=tree_regs.heading(col, "text"), anchor=tree_regs.column(col, "anchor"))
        tree_wifi_regs.column(col, width=tree_regs.column(col, "width"), anchor=tree_regs.column(col, "anchor"))

    tree_wifi_regs.tag_configure("updated", background="#e8f5e9", foreground="#1b5e20")
    tree_wifi_regs.tag_configure("normal", background="#ffffff")

    reg_scroll_y_wf = ttk.Scrollbar(reg_table_frame_wf, orient=tk.VERTICAL, command=tree_wifi_regs.yview)
    tree_wifi_regs.configure(yscrollcommand=reg_scroll_y_wf.set)
    tree_wifi_regs.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
    reg_scroll_y_wf.pack(side=tk.RIGHT, fill=tk.Y)

    def on_wifi_tree_select(event=None):
        sel = tree_wifi_regs.selection()
        if sel:
            tree_regs.selection_set(sel)
            tree_regs.see(sel[0])
            update_selection_state()

    tree_wifi_regs.bind("<<TreeviewSelect>>", on_wifi_tree_select)
    tree_wifi_regs.bind("<ButtonRelease-1>", on_wifi_tree_select)
    tree_wifi_regs.bind("<KeyRelease-Up>", on_wifi_tree_select)
    tree_wifi_regs.bind("<KeyRelease-Down>", on_wifi_tree_select)
    tree_wifi_regs.bind("<Double-1>", lambda e: dispatch_wifi_fetch(batch=False))

    # Selected Register Row: REG_NUMBER, VAL, CMKEY, PMKEY, cmd
    wf_row1 = ttk.Frame(f_wifi_right)
    wf_row1.pack(fill=tk.X, pady=2)

    ttk.Label(wf_row1, text="REG_NUMBER:").pack(side=tk.LEFT, padx=(2, 2))
    entry_wifi_reg_num_dyn = ttk.Entry(wf_row1, width=8, font=("Consolas", 9, "bold"))
    entry_wifi_reg_num_dyn.insert(0, saved_state.get("last_reg_num", "3355"))
    entry_wifi_reg_num_dyn.pack(side=tk.LEFT, padx=2)

    lbl_wifi_reg_name_hint = tk.Label(wf_row1, text="[GPRS_S]", font=("Consolas", 8, "italic"), fg="#555")
    lbl_wifi_reg_name_hint.pack(side=tk.LEFT, padx=(1, 4))

    ttk.Label(wf_row1, text="VAL:").pack(side=tk.LEFT, padx=(4, 2))
    entry_wifi_reg_val_dyn = ttk.Entry(wf_row1, width=7, font=("Consolas", 9, "bold"))
    entry_wifi_reg_val_dyn.insert(0, saved_state.get("last_reg_val", "0"))
    entry_wifi_reg_val_dyn.pack(side=tk.LEFT, padx=2)

    ttk.Label(wf_row1, text="CMKEY:").pack(side=tk.LEFT, padx=(5, 2))
    entry_wifi_cmkey_dyn = ttk.Entry(wf_row1, width=7, font=("Consolas", 9))
    entry_wifi_cmkey_dyn.insert(0, saved_state.get("cmkey", LIVE_KEYS.get("CMKEY", "155521")))
    entry_wifi_cmkey_dyn.pack(side=tk.LEFT, padx=2)

    ttk.Label(wf_row1, text="PMKEY:").pack(side=tk.LEFT, padx=(5, 2))
    entry_wifi_pmkey_dyn = ttk.Entry(wf_row1, width=7, font=("Consolas", 9))
    entry_wifi_pmkey_dyn.insert(0, saved_state.get("pmkey", LIVE_KEYS.get("PMKEY", "438266")))
    entry_wifi_pmkey_dyn.pack(side=tk.LEFT, padx=2)

    ttk.Label(wf_row1, text="cmd:").pack(side=tk.LEFT, padx=(5, 2))
    combo_wifi_cmd_dyn = ttk.Combobox(wf_row1, values=["read", "write"], width=5, state="readonly")
    combo_wifi_cmd_dyn.set(saved_state.get("cmd", "read"))
    combo_wifi_cmd_dyn.pack(side=tk.LEFT, padx=2)

    def sync_wifi_inputs_to_main(*args):
        entry_reg_num_dyn.delete(0, tk.END)
        entry_reg_num_dyn.insert(0, entry_wifi_reg_num_dyn.get().strip())
        entry_reg_val_dyn.delete(0, tk.END)
        entry_reg_val_dyn.insert(0, entry_wifi_reg_val_dyn.get().strip())
        entry_cmkey_dyn.delete(0, tk.END)
        entry_cmkey_dyn.insert(0, entry_wifi_cmkey_dyn.get().strip())
        entry_pmkey_dyn.delete(0, tk.END)
        entry_pmkey_dyn.insert(0, entry_wifi_pmkey_dyn.get().strip())
        combo_cmd_dyn.set(combo_wifi_cmd_dyn.get().strip())
        update_payload_preview()

    entry_wifi_reg_num_dyn.bind("<KeyRelease>", sync_wifi_inputs_to_main)
    entry_wifi_reg_val_dyn.bind("<KeyRelease>", sync_wifi_inputs_to_main)
    entry_wifi_cmkey_dyn.bind("<KeyRelease>", sync_wifi_inputs_to_main)
    entry_wifi_pmkey_dyn.bind("<KeyRelease>", sync_wifi_inputs_to_main)
    combo_wifi_cmd_dyn.bind("<<ComboboxSelected>>", sync_wifi_inputs_to_main)

    # Batch selection toolbar for WiFi
    wf_batch_row = ttk.Frame(f_wifi_right)
    wf_batch_row.pack(fill=tk.X, pady=1)

    def select_all_wifi_visible():
        all_items = tree_wifi_regs.get_children()
        tree_wifi_regs.selection_set(all_items)
        tree_regs.selection_set(all_items)
        update_selection_state()

    def clear_wifi_selection():
        tree_wifi_regs.selection_remove(tree_wifi_regs.selection())
        tree_regs.selection_remove(tree_regs.selection())
        update_selection_state()

    ttk.Button(wf_batch_row, text="🗹 Select All Visible", command=select_all_wifi_visible).pack(side=tk.LEFT, padx=2)
    ttk.Button(wf_batch_row, text="☐ Clear Selection", command=clear_wifi_selection).pack(side=tk.LEFT, padx=2)

    lbl_wifi_selection_count = ttk.Label(wf_batch_row, text="0 registers selected for batch", font=("Segoe UI", 8, "bold"), foreground="#1565c0")
    lbl_wifi_selection_count.pack(side=tk.LEFT, padx=8)

    # Selected Payload Preview (Box) for WiFi
    wf_prev_row = ttk.Frame(f_wifi_right)
    wf_prev_row.pack(fill=tk.X, pady=(3, 2))

    lbl_wifi_payload_preview = tk.Label(
        wf_prev_row,
        text='Payload: {"msgid":"...","CMKEY":"...","PMKEY":"...","type":"ondemand","cmd":"read","3355":0}',
        fg="#0d47a1",
        bg="#e8eaf6",
        font=("Consolas", 8),
        anchor=tk.W,
        relief=tk.SOLID,
        bd=1,
        padx=6,
        pady=3
    )
    lbl_wifi_payload_preview.pack(fill=tk.X, expand=True)

    # Action Toolbar: DIRECTLY BELOW THE SELECTED PAYLOAD
    wf_action_row = ttk.Frame(f_wifi_right)
    wf_action_row.pack(fill=tk.X, pady=(3, 2))

    btn_wifi_fetch_single = tk.Button(
