# ==============================================================================
#                  AUTOMATIC CREDENTIAL PERSISTENCE
# ==============================================================================

def load_server_credentials():
    """Loads saved server credentials from JSON."""
    if os.path.exists(CREDENTIALS_FILE):
        try:
            with open(CREDENTIALS_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass
    return {}


def save_server_credential(host, username, password, port=8883, client_id=""):
    """Automatically saves host and credentials into JSON file."""
    if not password:
        return
    creds = load_server_credentials()
    key = f"{username}@{host}:{port}"
    creds[key] = {
        "host": host,
        "port": port,
        "username": username,
        "password": password,
        "client_id": client_id,
        "updated_at": datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
    }
    creds[host] = {
        "host": host,
        "port": port,
        "username": username,
        "password": password,
        "client_id": client_id,
        "updated_at": datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
    }
    try:
        with open(CREDENTIALS_FILE, "w", encoding="utf-8") as f:
            json.dump(creds, f, indent=2)
    except Exception as e:
        print(f"[!] Warning: Could not save credentials to {CREDENTIALS_FILE}: {e}")


def get_saved_password(host, username="", port=8883):
    """Retrieves saved password for a host/user if available."""
    creds = load_server_credentials()
    key = f"{username}@{host}:{port}"
    if key in creds and creds[key].get("password"):
        return creds[key]["password"]
    if host in creds and creds[host].get("password"):
        return creds[host]["password"]
    return ""


# ==============================================================================
#           LOCAL WIFI & MODBUS POLL TCP/IP PROTOCOL ENGINE (DIRECT LAN / AP)
# ==============================================================================

MODBUS_TRANSACTION_ID = 1

def get_next_modbus_trans_id():
    """Generates sequential Modbus TCP transaction IDs."""
    global MODBUS_TRANSACTION_ID
    tid = MODBUS_TRANSACTION_ID
    MODBUS_TRANSACTION_ID = (MODBUS_TRANSACTION_ID + 1) & 0xFFFF
    if MODBUS_TRANSACTION_ID == 0:
        MODBUS_TRANSACTION_ID = 1
    return tid


def calc_modbus_crc16(data: bytes) -> int:
    """Calculates Modbus RTU CRC-16 (polynomial 0xA001)."""
    crc = 0xFFFF
    for pos in data:
        crc ^= pos
        for _ in range(8):
            if (crc & 1) != 0:
                crc = (crc >> 1) ^ 0xA001
            else:
                crc >>= 1
    return crc


def build_modbus_tcp_read_packet(unit_id=1, func_code=3, start_addr=3355, quantity=1, trans_id=None):
    """
    Builds standard Modbus TCP/IP Read request frame (MBAP 7 bytes + PDU 5 bytes = 12 bytes).
    Func 03 = Read Holding Registers, Func 04 = Read Input Registers.
    """
    if trans_id is None:
        trans_id = get_next_modbus_trans_id()
    pdu = struct.pack(">BHH", func_code, start_addr, quantity)
    # MBAP: TransID(2B) + ProtoID(2B=0x0000) + Length(2B) + UnitID(1B)
    mbap = struct.pack(">HHHB", trans_id, 0, len(pdu) + 1, unit_id)
    return mbap + pdu, trans_id


def build_modbus_tcp_write_packet(unit_id=1, reg_addr=3355, value=0, trans_id=None):
    """Builds standard Modbus TCP/IP Write Single Register frame (Func 06)."""
    if trans_id is None:
        trans_id = get_next_modbus_trans_id()
    pdu = struct.pack(">BHH", 6, reg_addr, value & 0xFFFF)
    mbap = struct.pack(">HHHB", trans_id, 0, len(pdu) + 1, unit_id)
    return mbap + pdu, trans_id


def parse_modbus_tcp_response(resp_bytes: bytes, start_reg: int = 3355):
    """
    Parses Modbus TCP response frame (MBAP + PDU).
    Returns: (success: bool, registers_dict: dict, description: str, func_code: int, exc_code: int)
    """
    if len(resp_bytes) < 9:
        return False, {}, f"Response frame too short ({len(resp_bytes)} bytes)", 0, 0
    trans_id, proto_id, length, unit_id, func_code = struct.unpack(">HHHBB", resp_bytes[:8])
    if func_code >= 0x80:
        exc_code = resp_bytes[8]
        exc_names = {
            1: "Illegal Function (Function not supported by device)",
            2: "Illegal Data Address (Register address out of range)",
            3: "Illegal Data Value (Value not accepted)",
            4: "Slave Device Failure (Internal device error)",
            5: "Acknowledge",
            6: "Slave Device Busy",
            10: "Gateway Path Unavailable",
            11: "Gateway Target Device Failed to Respond"
        }
        return False, {}, f"Modbus Exception 0x{func_code:02X} (Code {exc_code}: {exc_names.get(exc_code, 'Unknown Error')})", func_code, exc_code

    if func_code in (3, 4):
        byte_cnt = resp_bytes[8]
        val_bytes = resp_bytes[9:9+byte_cnt]
        num_regs = len(val_bytes) // 2
        regs = {}
        for i in range(num_regs):
            val = struct.unpack(">H", val_bytes[i*2:i*2+2])[0]
            regs[str(start_reg + i)] = val
        return True, regs, f"Read {num_regs} register(s) successfully", func_code, 0
    elif func_code == 6:
        addr, val = struct.unpack(">HH", resp_bytes[8:12])
        return True, {str(start_reg): val}, f"Written Register {addr} = {val} successfully", func_code, 0
    return True, {}, f"Function code {func_code} received", func_code, 0


def build_modbus_rtu_packet(unit_id=1, func_code=3, addr=3355, qty_or_val=1):
    """Builds Modbus RTU frame with CRC-16."""
    payload = struct.pack(">BBHH", unit_id, func_code, addr, qty_or_val)
    crc = calc_modbus_crc16(payload)
    return payload + struct.pack("<H", crc)


def parse_modbus_rtu_response(resp_bytes: bytes, start_reg: int = 3355):
    """Parses Modbus RTU response frame."""
    if len(resp_bytes) < 5:
        return False, {}, f"RTU frame too short ({len(resp_bytes)} bytes)", 0, 0
    expected_crc = calc_modbus_crc16(resp_bytes[:-2])
    actual_crc = struct.unpack("<H", resp_bytes[-2:])[0]
    if expected_crc != actual_crc:
        return False, {}, f"Modbus RTU CRC mismatch (expected 0x{expected_crc:04X}, received 0x{actual_crc:04X})", 0, 0
    unit_id, func_code = resp_bytes[0], resp_bytes[1]
    if func_code >= 0x80:
        exc_code = resp_bytes[2]
        return False, {}, f"Modbus Exception 0x{func_code:02X} Code {exc_code}", func_code, exc_code
    if func_code in (3, 4):
        byte_cnt = resp_bytes[2]
        val_bytes = resp_bytes[3:3+byte_cnt]
        num_regs = len(val_bytes) // 2
        regs = {}
        for i in range(num_regs):
            val = struct.unpack(">H", val_bytes[i*2:i*2+2])[0]
            regs[str(start_reg + i)] = val
        return True, regs, f"Read {num_regs} register(s) successfully", func_code, 0
    elif func_code == 6:
        addr, val = struct.unpack(">HH", resp_bytes[2:6])
        return True, {str(start_reg): val}, f"Written Register {addr} = {val} successfully", func_code, 0
    return True, {}, f"Function code {func_code} received", func_code, 0


def ping_local_wifi_device(ip, port, timeout=2.0):
    """Pings/tests TCP connectivity to a local WiFi device (e.g. ESP32/Modbus gateway)."""
    t0 = time.time()
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect((ip, int(port)))
        s.close()
        rtt_ms = round((time.time() - t0) * 1000.0, 1)
        return True, rtt_ms, f"Connected ({rtt_ms} ms)"
    except Exception as e:
        rtt_ms = round((time.time() - t0) * 1000.0, 1)
        return False, rtt_ms, str(e)


def query_modbus_device(ip, port=502, unit_id=1, func_code=3, reg_addr=3355, quantity=1, value=0, is_write=False, zero_based=True, is_rtu=False, timeout=2.5):
    """
    Dispatches native Modbus TCP or Modbus RTU-over-TCP request.
    Returns: (success: bool, registers_dict: dict, tx_hex: str, rx_hex: str, rtt_ms: float, error_msg: str, trace_log: str)
    """
    t0 = time.time()
    wire_addr = (reg_addr - 1) if (zero_based and reg_addr > 0) else reg_addr

    if is_rtu:
        if is_write:
            tx_bytes = build_modbus_rtu_packet(unit_id=unit_id, func_code=6, addr=wire_addr, qty_or_val=value)
            cmd_desc = f"Modbus RTU Write Reg (Unit: {unit_id}, Addr: {reg_addr} -> Wire: {wire_addr}, Val: {value})"
        else:
            tx_bytes = build_modbus_rtu_packet(unit_id=unit_id, func_code=func_code, addr=wire_addr, qty_or_val=quantity)
            cmd_desc = f"Modbus RTU Read Regs (Unit: {unit_id}, Func: {func_code}, Addr: {reg_addr} -> Wire: {wire_addr}, Qty: {quantity})"
    else:
        if is_write:
            tx_bytes, tid = build_modbus_tcp_write_packet(unit_id=unit_id, reg_addr=wire_addr, value=value)
            cmd_desc = f"Modbus TCP Write Reg (Unit: {unit_id}, Func: 06, Addr: {reg_addr} -> Wire: {wire_addr}, Val: {value}, TID: {tid})"
        else:
            tx_bytes, tid = build_modbus_tcp_read_packet(unit_id=unit_id, func_code=func_code, start_addr=wire_addr, quantity=quantity)
            cmd_desc = f"Modbus TCP Read Regs (Unit: {unit_id}, Func: 0{func_code}, Addr: {reg_addr} -> Wire: {wire_addr}, Qty: {quantity}, TID: {tid})"

    tx_hex = " ".join(f"{b:02X}" for b in tx_bytes)
    now_str = datetime.now().strftime("%H:%M:%S.%f")[:-3]

    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect((ip, int(port)))
        s.sendall(tx_bytes)
        rx_bytes = s.recv(1024)
        s.close()
        rtt_ms = round((time.time() - t0) * 1000.0, 1)
        rx_hex = " ".join(f"{b:02X}" for b in rx_bytes)

        if is_rtu:
            ok, regs, desc, fc, exc = parse_modbus_rtu_response(rx_bytes, start_reg=reg_addr)
        else:
            ok, regs, desc, fc, exc = parse_modbus_tcp_response(rx_bytes, start_reg=reg_addr)

        trace = (
            f"[{now_str}] >>> MODBUS TX -> {ip}:{port}\n"
            f"  Command : {cmd_desc}\n"
            f"  Raw Hex : [ {tx_hex} ] ({len(tx_bytes)} bytes)\n"
            f"[{datetime.now().strftime('%H:%M:%S.%f')[:-3]}] <<< MODBUS RX <- {ip}:{port} (RTT: {rtt_ms} ms)\n"
            f"  Raw Hex : [ {rx_hex} ] ({len(rx_bytes)} bytes)\n"
            f"  Result  : {'SUCCESS' if ok else 'ERROR'} | {desc}\n"
        )
        if ok and regs:
            reg_lines = [f"  Reg {r} = {v} (0x{v:04X})" for r, v in regs.items()]
            trace += "\n".join(reg_lines) + "\n"

        return ok, regs, tx_hex, rx_hex, rtt_ms, ("" if ok else desc), trace

    except Exception as e:
        rtt_ms = round((time.time() - t0) * 1000.0, 1)
        err_str = str(e) or "Timeout / Connection Failed"
        trace = (
            f"[{now_str}] >>> MODBUS TX -> {ip}:{port}\n"
            f"  Command : {cmd_desc}\n"
            f"  Raw Hex : [ {tx_hex} ] ({len(tx_bytes)} bytes)\n"
            f"[{datetime.now().strftime('%H:%M:%S.%f')[:-3]}] ✗ ERROR <- {ip}:{port} (RTT: {rtt_ms} ms)\n"
            f"  Failure : {err_str}\n"
        )
        return False, {}, tx_hex, "", rtt_ms, err_str, trace


def probe_wifi_device_protocols(ip, default_port=502, timeout=1.5):
    """
    Automatically probes remote WiFi device to detect protocol:
    1. Modbus TCP on Port 502 / default_port
    2. Modbus TCP on Port 5020 / 8899
    3. Modbus RTU over TCP on Port 502 / 8899
    4. HTTP API on Port 80 / 8080
    Returns: (found: bool, detected_proto: str, working_port: int, slave_id: int, rtt_ms: float, details: str)
    """
    ports_to_try = [int(default_port)] if int(default_port) not in [502, 80] else []
    ports_to_try.extend([502, 80, 8080, 8899, 5020])
    ports_to_try = list(dict.fromkeys(ports_to_try))

    # 1. Try Modbus TCP
    for p in ports_to_try:
        for uid in (1, 255, 0):
            ok, regs, tx, rx, rtt, err, tr = query_modbus_device(ip, port=p, unit_id=uid, func_code=3, reg_addr=3355, quantity=1, zero_based=True, is_rtu=False, timeout=timeout)
            if ok or (rx and len(rx) >= 9):
                return True, "Modbus TCP/IP (Port 502 - Func 03 Holding Regs)", p, uid, rtt, f"Modbus TCP detected on Port {p} (Unit ID {uid}, RTT {rtt} ms)"
            ok4, regs4, tx4, rx4, rtt4, err4, tr4 = query_modbus_device(ip, port=p, unit_id=uid, func_code=4, reg_addr=3355, quantity=1, zero_based=True, is_rtu=False, timeout=timeout)
            if ok4 or (rx4 and len(rx4) >= 9):
                return True, "Modbus TCP/IP (Port 502 - Func 04 Input Regs)", p, uid, rtt4, f"Modbus TCP (Func 04) detected on Port {p} (Unit ID {uid}, RTT {rtt4} ms)"

    # 2. Try Modbus RTU over TCP
    for p in [502, 8899]:
        ok, regs, tx, rx, rtt, err, tr = query_modbus_device(ip, port=p, unit_id=1, func_code=3, reg_addr=3355, quantity=1, is_rtu=True, timeout=timeout)
        if ok:
            return True, "Modbus RTU over TCP (Port 502 / 8899)", p, 1, rtt, f"Modbus RTU over TCP detected on Port {p} (RTT {rtt} ms)"

    # 3. Try HTTP
    for p in [80, 8080]:
        try:
            t0 = time.time()
            req = urllib.request.Request(f"http://{ip}:{p}/", headers={'User-Agent': 'ModbusProbe'}, method='GET')
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                rtt = round((time.time() - t0) * 1000.0, 1)
                return True, "HTTP POST (/ondemand)", p, 1, rtt, f"HTTP Server detected on Port {p} (Status {resp.status}, RTT {rtt} ms)"
        except Exception:
            pass

    # 4. Fallback TCP Ping
    for p in ports_to_try:
        ok_ping, rtt_ping, _ = ping_local_wifi_device(ip, p, timeout=timeout)
        if ok_ping:
            return True, "Modbus TCP/IP (Port 502 - Func 03 Holding Regs)", p, 1, rtt_ping, f"TCP Port {p} is OPEN! Connected as Modbus TCP (RTT {rtt_ping} ms)"

    return False, "Modbus TCP/IP (Port 502 - Func 03 Holding Regs)", 502, 1, 0.0, f"No responding Modbus or HTTP services found on {ip}"


def query_local_wifi_device(ip, port, protocol, payload_dict, unit_id=1, zero_based=True, timeout=3.5):
    """
    Dispatches query to a local WiFi device via Modbus TCP, Modbus RTU over TCP, HTTP POST, HTTP GET, or TCP Socket.
    Returns: (success: bool, response_dict: dict, raw_text: str, rtt_ms: float, error_msg: str, trace_log: str)
    """
    proto_up = protocol.upper()

    # 1. Modbus TCP or RTU over TCP
    if "MODBUS" in proto_up:
        is_rtu = "RTU" in proto_up
        func_code = 4 if ("04" in proto_up or "INPUT" in proto_up) else 3
        cmd = payload_dict.get("cmd", "read").lower()
        is_write = (cmd == "write")

        # Extract register number and value from payload
        reg_num = 3355
        reg_val = 0
        for k, v in payload_dict.items():
            if k not in ["msgid", "CMKEY", "PMKEY", "timestamp", "type", "cmd"]:
                try:
                    reg_num = int(k)
                    reg_val = int(v) if str(v).isdigit() else 0
                    break
                except ValueError:
                    pass

        # Check if multiple registers in batch read
        reg_keys = [int(k) for k in payload_dict.keys() if k not in ["msgid", "CMKEY", "PMKEY", "timestamp", "type", "cmd"] and str(k).isdigit()]
        if len(reg_keys) > 1 and not is_write:
            min_r = min(reg_keys)
            max_r = max(reg_keys)
            qty = max(1, min(max_r - min_r + 1, 125))
            ok, regs, tx, rx, rtt, err, trace = query_modbus_device(
                ip, port=int(port), unit_id=unit_id, func_code=func_code,
                reg_addr=min_r, quantity=qty, value=0, is_write=False,
                zero_based=zero_based, is_rtu=is_rtu, timeout=timeout
            )
            filtered_regs = {str(k): regs.get(str(k), 1) for k in reg_keys} if ok else {}
            return ok, filtered_regs, (rx or tx), rtt, err, trace
        else:
            ok, regs, tx, rx, rtt, err, trace = query_modbus_device(
                ip, port=int(port), unit_id=unit_id, func_code=func_code,
                reg_addr=reg_num, quantity=1, value=reg_val, is_write=is_write,
                zero_based=zero_based, is_rtu=is_rtu, timeout=timeout
            )
            return ok, regs, (rx or tx), rtt, err, trace

    # 2. HTTP POST
    elif "POST" in proto_up:
        t0 = time.time()
        payload_json = json.dumps(payload_dict)
        url = f"http://{ip}:{port}/ondemand"
        req = urllib.request.Request(
            url,
            data=payload_json.encode('utf-8'),
            headers={'Content-Type': 'application/json', 'User-Agent': 'MQTT-SCADA-Controller/2.0'},
            method='POST'
        )
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                raw_bytes = resp.read()
                raw_text = raw_bytes.decode('utf-8', errors='replace')
                rtt_ms = round((time.time() - t0) * 1000.0, 1)
                trace = f"[{datetime.now().strftime('%H:%M:%S')}] HTTP POST {url} -> 200 OK ({rtt_ms} ms)\nResponse: {raw_text}\n"
                try:
                    data = json.loads(raw_text)
                    return True, data, raw_text, rtt_ms, "", trace
                except json.JSONDecodeError:
                    return True, {}, raw_text, rtt_ms, "", trace
        except Exception as e:
            rtt_ms = round((time.time() - t0) * 1000.0, 1)
            trace = f"[{datetime.now().strftime('%H:%M:%S')}] HTTP POST {url} -> Failed: {e} ({rtt_ms} ms)\n"
            return False, {}, "", rtt_ms, str(e), trace

    # 3. HTTP GET
    elif "GET" in proto_up:
        t0 = time.time()
        params = [f"{k}={urllib.parse.quote(str(v))}" for k, v in payload_dict.items()]
        query_str = "&".join(params)
        url = f"http://{ip}:{port}/ondemand?{query_str}"
        req = urllib.request.Request(url, headers={'User-Agent': 'MQTT-SCADA-Controller/2.0'}, method='GET')
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                raw_bytes = resp.read()
                raw_text = raw_bytes.decode('utf-8', errors='replace')
                rtt_ms = round((time.time() - t0) * 1000.0, 1)
                trace = f"[{datetime.now().strftime('%H:%M:%S')}] HTTP GET {url} -> 200 OK ({rtt_ms} ms)\nResponse: {raw_text}\n"
                try:
                    data = json.loads(raw_text)
                    return True, data, raw_text, rtt_ms, "", trace
                except json.JSONDecodeError:
                    return True, {}, raw_text, rtt_ms, "", trace
        except Exception as e:
            rtt_ms = round((time.time() - t0) * 1000.0, 1)
            trace = f"[{datetime.now().strftime('%H:%M:%S')}] HTTP GET {url} -> Failed: {e} ({rtt_ms} ms)\n"
            return False, {}, "", rtt_ms, str(e), trace

    # 4. TCP Direct Socket (JSON)
    else:
        t0 = time.time()
        payload_json = json.dumps(payload_dict)
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.settimeout(timeout)
            s.connect((ip, int(port)))
            s.sendall((payload_json + "\n").encode('utf-8'))
            resp_bytes = s.recv(4096)
            s.close()
            rtt_ms = round((time.time() - t0) * 1000.0, 1)
            raw_text = resp_bytes.decode('utf-8', errors='replace')
            trace = f"[{datetime.now().strftime('%H:%M:%S')}] TCP Direct -> {ip}:{port} ({rtt_ms} ms)\nResponse: {raw_text}\n"
            try:
                data = json.loads(raw_text.strip())
                return True, data, raw_text, rtt_ms, "", trace
            except json.JSONDecodeError:
                return True, {}, raw_text, rtt_ms, "", trace
        except Exception as e:
            rtt_ms = round((time.time() - t0) * 1000.0, 1)
            trace = f"[{datetime.now().strftime('%H:%M:%S')}] TCP Direct {ip}:{port} -> Failed: {e} ({rtt_ms} ms)\n"
            return False, {}, "", rtt_ms, str(e), trace

# ==============================================================================
#                  RTEVENT EXCEL (CSV) & TEXT LOGGING
# ==============================================================================

CSV_HEADERS = [
    "Log_Timestamp_UTC",
    "Topic",
    "IMEI",
    "Device_Timestamp",
    "Voltage_VN",
    "Frequency_FREQ",
    "Power_POW",
    "Reactive_Power_RPOW",
    "CMKEY",
    "PMKEY",
    "INDEX",
    "STINTERVAL",
    "VD",
    "Raw_JSON"
]


def init_rtevent_csv():
    """Initializes CSV header if file does not exist."""
    if not os.path.exists(RTEVENT_CSV_LOG):
        try:
            with open(RTEVENT_CSV_LOG, "w", newline="", encoding="utf-8") as f:
                writer = csv.writer(f)
                writer.writerow(CSV_HEADERS)
        except Exception as e:
            print(f"[!] Could not init {RTEVENT_CSV_LOG}: {e}")


def log_rtevent_data(topic, payload_str, data_dict=None):
    """Appends an incoming 'rtevent' record to rtevent_logs.csv and rtevent_logs.txt."""
    now_utc = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S")

    d = data_dict or {}
    imei = str(d.get("IMEI", "") or "")
    if not imei:
        parts = topic.split("/")
        if len(parts) >= 3:
            imei = parts[2]

    dev_ts = str(d.get("TIMESTAMP", "") or d.get("DATE", "") or "")
    vn = d.get("IS-1-0---VN", "")
    freq = d.get("IS-1-0---FREQ", "")
    pow_w = d.get("IS-1-0---POW", "")
    rpow = d.get("IS-1-0---RPOW", "")
    cmkey = d.get("CMKEY", "")
    pmkey = d.get("PMKEY", "")
    idx = d.get("INDEX", "")
    stinterval = d.get("STINTERVAL", "")
    vd = d.get("VD", "")

    init_rtevent_csv()
    try:
        with open(RTEVENT_CSV_LOG, "a", newline="", encoding="utf-8") as f:
            writer = csv.writer(f)
            writer.writerow([
                now_utc,
                topic,
                imei,
                dev_ts,
                vn,
                freq,
                pow_w,
                rpow,
                cmkey,
                pmkey,
                idx,
                stinterval,
                vd,
                payload_str
            ])
    except Exception as e:
        print(f"[!] Error writing to {RTEVENT_CSV_LOG}: {e}")

    try:
        with open(RTEVENT_TXT_LOG, "a", encoding="utf-8") as f:
            f.write(f"[{now_utc} UTC] Topic: {topic}\n")
            f.write(f"  IMEI: {imei} | Timestamp: {dev_ts}\n")
            f.write(f"  Voltage: {vn} V | Frequency: {freq} Hz | Power: {pow_w} W | RPower: {rpow} VAR\n")
            f.write(f"  INDEX: {idx} | CMKEY: {cmkey} | PMKEY: {pmkey} | STINTERVAL: {stinterval}\n")
            f.write(f"  Payload: {payload_str}\n")
            f.write("-" * 80 + "\n")
    except Exception as e:
        print(f"[!] Error writing to {RTEVENT_TXT_LOG}: {e}")


# ==============================================================================
#                  CONNECTION HISTORY & CONFIG LOADERS
# ==============================================================================

def load_connection_history():
    """Loads connection history from JSON file or initializes with default connection #1."""
    if os.path.exists(HISTORY_FILE):
        try:
            with open(HISTORY_FILE, "r", encoding="utf-8") as f:
                history = json.load(f)
                if isinstance(history, list) and len(history) > 0:
                    return history
        except Exception:
            pass

    initial_history = [
        {
            "connection_num": 1,
            "name": "RMS IoT SCADA (866738083619898)",
            "host": "rms.iotscada-pmsg.com",
            "port": 8883,
            "use_tls": True,
            "username": "test",
            "imei": "866738083619898",
            "timestamp": datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC"),
            "config": DEFAULT_CONFIG
        }
    ]
    save_connection_history(initial_history)
    return initial_history


def save_connection_history(history):
    """Saves connection history list to JSON file."""
    try:
        with open(HISTORY_FILE, "w", encoding="utf-8") as f:
            json.dump(history, f, indent=2)
    except Exception as e:
        print(f"[!] Warning: Could not save connection history: {e}")


def add_to_connection_history(name, host, port, use_tls, username, imei, config):
    """Adds a new connection record to history and returns the updated history and entry."""
    history = load_connection_history()
    next_num = len(history) + 1
    new_entry = {
        "connection_num": next_num,
        "name": name or f"Connection #{next_num} ({host})",
        "host": host,
        "port": port,
        "use_tls": use_tls,
        "username": username,
        "imei": imei,
        "timestamp": datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC"),
        "config": config
    }
    history.append(new_entry)
    save_connection_history(history)
    return history, new_entry


def print_previous_connections(history):
    """Lists all previous connections formatted with their connection numbers."""
    print("\n" + "=" * 80)
    print("                    PREVIOUS SAVED CONNECTIONS")
    print("=" * 80)
    for item in history:
        c_num = item.get("connection_num", 1)
        c_name = item.get("name", "Unnamed Connection")
        host = item.get("host", "N/A")
        port = item.get("port", "N/A")
        tls = item.get("use_tls", False)
        imei = item.get("imei", "N/A")
        user = item.get("username", "None")
        ts = item.get("timestamp", "N/A")
        topic_count = len(item.get("config", {}).get("topics", {}).get("info_subscriptions", []))

        print(f"  [Connection #{c_num}] {c_name}")
        print(f"    * Endpoint    : {host}:{port} (TLS: {tls})")
        print(f"    * Device IMEI : {imei}")
        print(f"    * Username    : {user}")
        print(f"    * Topics      : {topic_count} subscription topic(s)")
        print(f"    * Saved Date  : {ts}")
        print("-" * 80)


def generate_single_imei_topics(imei):
    """Generates subscription topics for a SINGLE IMEI including device-level wildcard #."""
    subs = [
        f"rtsg-1/ongridrooftop/{imei}/#",
        f"rtsg-1/ongridrooftop/{imei}/ondemand/pub",
        f"rtsg-1/ongridrooftop/{imei}/data/pub",
        f"rtsg-1/ongridrooftop/{imei}/heartbeat/pub",
        f"rtsg-1/ongridrooftop/{imei}/config/pub",
        f"rtsg-1/ongridrooftop/{imei}/rtevent/pub",
        f"rtsg-1/ongridrooftop/{imei}/ondemand/sub",
        f"rtsg-1/ongridrooftop/{imei}/config/sub",
        f"rtsg-1/ongridrooftop/{imei}/messagekey/sub",
        f"rtsg-1/ongridrooftop/{imei}/info/sub"
    ]

    return {
        "ondemand_sub_template": f"rtsg-1/ongridrooftop/{imei}/ondemand/sub",
        "config_sub_template": f"rtsg-1/ongridrooftop/{imei}/config/sub",
        "messagekey_sub_template": f"rtsg-1/ongridrooftop/{imei}/messagekey/sub",
        "info_sub_template": f"rtsg-1/ongridrooftop/{imei}/info/sub",
        "data_pub_template": f"rtsg-1/ongridrooftop/{imei}/data/pub",
        "heartbeat_pub_template": f"rtsg-1/ongridrooftop/{imei}/heartbeat/pub",
        "ondemand_pub_template": f"rtsg-1/ongridrooftop/{imei}/ondemand/pub",
        "config_pub_template": f"rtsg-1/ongridrooftop/{imei}/config/pub",
        "rtevent_pub_template": f"rtsg-1/ongridrooftop/{imei}/rtevent/pub",
        "info_subscriptions": subs
    }


def load_yaml(filepath):
    if HAS_YAML:
        with open(filepath, "r", encoding="utf-8") as f:
            return yaml.safe_load(f)

    with open(filepath, "r", encoding="utf-8") as f:
        lines = f.readlines()

    cfg = {"broker": {}, "topics": {"info_subscriptions": []}, "settings": {}, "registered_devices": []}
    curr_section = None
    curr_dev = None

    for line in lines:
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue

        if not line.startswith(" ") and not line.startswith("\t") and stripped.endswith(":"):
            curr_section = stripped[:-1].strip()
            continue

        if curr_section == "broker":
            if ":" in stripped:
                k, v = stripped.split(":", 1)
                k = k.strip()
                v = v.split("#")[0].strip().strip('"').strip("'")
                if v.isdigit():
                    cfg["broker"][k] = int(v)
                elif v.lower() in ["true", "false"]:
                    cfg["broker"][k] = v.lower() == "true"
                else:
                    cfg["broker"][k] = v
        elif curr_section == "topics":
            if stripped.startswith("-"):
                topic_val = stripped.lstrip("-").strip().strip('"').strip("'")
                if not isinstance(cfg["topics"].get("info_subscriptions"), list):
                    cfg["topics"]["info_subscriptions"] = []
                cfg["topics"]["info_subscriptions"].append(topic_val)
            elif ":" in stripped:
                k, v = stripped.split(":", 1)
                k = k.strip()
                v = v.split("#")[0].strip().strip('"').strip("'")
                if k == "info_subscriptions":
                    if not isinstance(cfg["topics"].get("info_subscriptions"), list):
                        cfg["topics"]["info_subscriptions"] = []
                else:
                    cfg["topics"][k] = v
        elif curr_section == "settings":
            if ":" in stripped:
                k, v = stripped.split(":", 1)
                k = k.strip()
                v = v.split("#")[0].strip().strip('"').strip("'")
                if v.isdigit():
                    cfg["settings"][k] = int(v)
                elif v.lower() in ["true", "false"]:
                    cfg["settings"][k] = v.lower() == "true"
                else:
                    cfg["settings"][k] = v
        elif curr_section == "registered_devices":
            if stripped.startswith("-"):
                curr_dev = {}
                cfg["registered_devices"].append(curr_dev)
                line_content = stripped.lstrip("-").strip()
                if ":" in line_content:
                    k, v = line_content.split(":", 1)
                    k = k.strip()
                    v = v.split("#")[0].strip().strip('"').strip("'")
                    curr_dev[k] = v
            elif curr_dev is not None and ":" in stripped:
                k, v = stripped.split(":", 1)
                k = k.strip()
                v = v.split("#")[0].strip().strip('"').strip("'")
                if v.lower() in ["true", "false"]:
                    curr_dev[k] = v.lower() == "true"
                else:
                    curr_dev[k] = v

    return cfg


def load_json(filepath):
    with open(filepath, "r", encoding="utf-8") as f:
        return json.load(f)


def load_xml(filepath):
    tree = ET.parse(filepath)
    root = tree.getroot()

    def get_text(node, tag, default=""):
        elem = node.find(tag)
        return elem.text.strip() if elem is not None and elem.text else default

    cfg = {"broker": {}, "topics": {"info_subscriptions": []}, "settings": {}, "registered_devices": []}
    b_node = root.find("broker")
    if b_node is not None:
        cfg["broker"]["name"] = get_text(b_node, "name", "MQTT Broker")
        cfg["broker"]["host"] = get_text(b_node, "host", "rms.iotscada-pmsg.com")
        cfg["broker"]["port"] = int(get_text(b_node, "port", "8883"))
        cfg["broker"]["protocol"] = get_text(b_node, "protocol", "mqtts")
        cfg["broker"]["client_id"] = get_text(b_node, "client_id", "84e738ec-179a-4546-88af-cc3ba679d08d")
        cfg["broker"]["append_timestamp"] = get_text(b_node, "append_timestamp", "false").lower() == "true"
        cfg["broker"]["username"] = get_text(b_node, "username", "test")
        cfg["broker"]["password"] = get_text(b_node, "password", "")
        cfg["broker"]["keepalive"] = int(get_text(b_node, "keepalive", "10"))
        cfg["broker"]["clean_session"] = get_text(b_node, "clean_session", "false").lower() == "true"
        cfg["broker"]["use_tls"] = get_text(b_node, "use_tls", "true").lower() == "true"

    t_node = root.find("topics")
    if t_node is not None:
        for child in t_node:
            if child.tag == "info_subscriptions":
                for top in child.findall("topic"):
                    if top.text:
                        cfg["topics"]["info_subscriptions"].append(top.text.strip())
            else:
                cfg["topics"][child.tag] = child.text.strip() if child.text else ""

    s_node = root.find("settings")
    if s_node is not None:
        cfg["settings"]["auto_poll"] = get_text(s_node, "auto_poll", "true").lower() == "true"
        cfg["settings"]["poll_interval_seconds"] = int(get_text(s_node, "poll_interval_seconds", "15"))
        cfg["settings"]["response_timeout_seconds"] = int(get_text(s_node, "response_timeout_seconds", "30"))
        cfg["settings"]["payload_to_send"] = get_text(s_node, "payload_to_send", '{"msgid":"6374196","CMKEY":"155521","PMKEY":"438266","type":"ondemand","cmd":"read","3355":0}')

    rd_node = root.find("registered_devices")
    if rd_node is not None:
        for dev in rd_node.findall("device"):
            cfg["registered_devices"].append({
                "imei": get_text(dev, "imei", ""),
                "name": get_text(dev, "name", ""),
                "device_type": get_text(dev, "device_type", ""),
                "location": get_text(dev, "location", ""),
                "enabled": get_text(dev, "enabled", "true").lower() == "true"
            })
    return cfg


def load_config_file(filepath):
    ext = os.path.splitext(filepath)[1].lower()
    if ext in [".yaml", ".yml"]:
        return load_yaml(filepath)
    elif ext == ".json":
        return load_json(filepath)
    elif ext == ".xml":
        return load_xml(filepath)
    else:
        raise ValueError(f"Unsupported config extension: {ext}")


# ==============================================================================
#                  CORE LIVE CLIENT (MQTTS & TARGET IMEI FILTER)
# ==============================================================================

def run_live_client(config, once=False, cli_password=None, on_message_callback=None, stop_event=None, on_client_ready=None):
    """
    Connects to MQTT Broker with TLS and MQTT v3.1.1 protocol.
    Subscribes to target device using '#', capturing 100% of telemetry and ondemand data.
    Provides interactive terminal dispatch so pressing [Enter] publishes ondemand requests.
    """
    if not HAS_PAHO:
        print("[!] Error: paho-mqtt package is not installed.")
        print("Please install dependencies: pip install -r requirements.txt")
        return

    broker = config.get("broker", {})
    host = broker.get("host", "rms.iotscada-pmsg.com")
    port = int(broker.get("port", 8883))
    username = broker.get("username", "test")
    use_tls = broker.get("use_tls", True)
    keepalive = int(broker.get("keepalive", 10))
    clean_session = bool(broker.get("clean_session", False))
    client_id_base = broker.get("client_id", "84e738ec-179a-4546-88af-cc3ba679d08d")
    append_ts = bool(broker.get("append_timestamp", False))
    connect_timeout = int(broker.get("connect_timeout", 30))

    settings = config.get("settings", {})
    payload_to_send = settings.get("payload_to_send", '{"msgid":"6374196","CMKEY":"155521","PMKEY":"438266","type":"ondemand","cmd":"read","3355":0}')
    target_imei_only = bool(settings.get("target_imei_only", True))
    rtevent_mode = settings.get("rtevent_display_mode", "compact").lower()

    devices = {str(d.get("imei")): d for d in config.get("registered_devices", [])}
    target_imei_list = list(devices.keys())
    if not target_imei_list:
        target_imei_list = [str(broker.get("name", "866738083619898"))]

    primary_imei = target_imei_list[0]

    password = cli_password or broker.get("password", "")
    if not password:
        password = get_saved_password(host, username, port)

    if not password and sys.stdin.isatty():
        password = getpass.getpass(f"Enter password for {username}@{host} (saved automatically): ")

    if password:
        save_server_credential(host, username, password, port, client_id_base)

    client_id = f"{client_id_base}_{int(time.time())}" if append_ts else client_id_base

    topics = config.get("topics", {})
    raw_subs = topics.get("info_subscriptions", [])

    # Filter subscriptions: remove global wildcards (+), keep device-level wildcard (#)
    clean_subs = []
    for s in raw_subs:
        if "+" in s:
            continue
        if s not in clean_subs:
            clean_subs.append(s)

    # Ensure device-level wildcard for target IMEI is included
    device_wildcard = f"rtsg-1/ongridrooftop/{primary_imei}/#"
    if device_wildcard not in clean_subs:
        clean_subs.insert(0, device_wildcard)

    print("\n" + "=" * 80)
    print("       MQTT SCADA & ONDEMAND CONTROLLER")
    print("=" * 80)
    print(f"Broker Endpoint   : {host}:{port} (TLS: {use_tls})")
    print(f"MQTT Client ID    : {client_id}")
    print(f"MQTT Username     : {username}")
    print(f"Target Device IMEI: {primary_imei} (Device-Scoped Wildcard: Enabled)")
    print(f"Telemetry Mode    : {rtevent_mode.upper()} (Auto-logged to rtevent_logs.csv)")
    print(f"Subscribed Topics ({len(clean_subs)} topics):")
    for s in clean_subs:
        print(f"  * {s}")
    print("=" * 80)

    try:
        client = mqtt.Client(
            callback_api_version=mqtt.CallbackAPIVersion.VERSION2,
            client_id=client_id,
            clean_session=clean_session,
            protocol=mqtt.MQTTv311
        )
    except (TypeError, AttributeError):
        try:
            client = mqtt.Client(
                mqtt.CallbackAPIVersion.VERSION2,
                client_id=client_id,
                clean_session=clean_session,
                protocol=mqtt.MQTTv311
            )
        except (TypeError, AttributeError):
            client = mqtt.Client(client_id=client_id, clean_session=clean_session, protocol=mqtt.MQTTv311)

    if username:
        client.username_pw_set(username, password)

    if use_tls:
        context = ssl.create_default_context()
        context.check_hostname = False
        context.verify_mode = ssl.CERT_NONE
        client.tls_set_context(context)

    state = {
        "connected": False,
        "got_response": False,
        "last_dispatch_time": 0
    }

    def on_connect(cli, userdata, flags, rc, properties=None):
        rc_code = rc if isinstance(rc, int) else getattr(rc, "value", rc)
        if rc_code == 0:
            print("\n[+] Successfully connected to MQTT Broker!")
            state["connected"] = True
            for s in clean_subs:
                cli.subscribe(s, qos=0)
        else:
            err_reasons = {
                1: "Connection refused: Incorrect protocol version",
                2: "Connection refused: Identifier rejected",
                3: "Connection refused: Server unavailable",
                4: "Connection refused: Bad username or password",
                5: "Connection refused: Not authorized",
                134: "Connection refused (0x86 / 134): Bad username, password, or unauthorized Client ID",
                135: "Connection refused (0x87 / 135): Not authorized"
            }
            err_desc = err_reasons.get(rc_code, f"Error Code {rc_code}")
            print(f"\n[!] Connection failed: {err_desc}")

    def on_message(cli, userdata, msg):
        topic = msg.topic
        payload_str = msg.payload.decode("utf-8", errors="ignore")
        rtt_str = ""
        if state["last_dispatch_time"] > 0:
            rtt = (time.time() - state["last_dispatch_time"]) * 1000
            rtt_str = f" | RTT: {rtt:.1f} ms"

        # Check if topic belongs to target IMEI
        is_for_target = any(imei in topic for imei in target_imei_list if imei)
        if target_imei_only and not is_for_target:
            return

        parsed_dict = None
        try:
            parsed_dict = json.loads(payload_str)
        except Exception:
            pass

        now_utc = datetime.now(timezone.utc).strftime("%H:%M:%S")
        is_rtevent = "rtevent" in topic.lower() or (parsed_dict and "rtevent" in str(parsed_dict).lower())

        if is_rtevent:
            # 1. Log to Excel/CSV in the background
            log_rtevent_data(topic, payload_str, parsed_dict)

            # 2. Console display
            if rtevent_mode == "compact":
                d = parsed_dict or {}
                vn = d.get("IS-1-0---VN", "N/A")
                freq = d.get("IS-1-0---FREQ", "N/A")
                pow_w = d.get("IS-1-0---POW", "N/A")
                idx = d.get("INDEX", "N/A")
                dev_ts = d.get("TIMESTAMP", d.get("DATE", now_utc))
                print(f"[{now_utc}] [LIVE TELEMETRY] IMEI: {primary_imei} | VN: {vn}V | FREQ: {freq}Hz | POW: {pow_w}W | INDEX: {idx} | DevTime: {dev_ts}")
            elif rtevent_mode == "full":
                print("\n" + "=" * 80)
                print(f"[RTEVENT TELEMETRY] Topic: {topic} | Time: {now_utc} UTC")
                print("-" * 80)
                if parsed_dict:
                    for k, v in parsed_dict.items():
                        print(f"  {k:15}: {v}")
                else:
                    print(f"  {payload_str}")
                print("=" * 80)

        elif "messagekey" in topic.lower():
            print("\n" + "=" * 80)
            print(f"[DEVICE MESSAGEKEY RECEIVED] Topic: {topic}")
            if parsed_dict:
                cm = str(parsed_dict.get("CMKEY", "") or "")
                pm = str(parsed_dict.get("PMKEY", "") or "")
                if cm:
                    LIVE_KEYS["CMKEY"] = cm
                if pm:
                    LIVE_KEYS["PMKEY"] = pm
                print(f"  CMKEY    : {cm or parsed_dict.get('CMKEY')}")
                print(f"  PMKEY    : {pm or parsed_dict.get('PMKEY')}")
                print(f"  Timestamp: {parsed_dict.get('timestamp')}")
            else:
                print(f"  Payload  : {payload_str}")
            print(f"  -> Device '{primary_imei}' is online and active!")

            # Auto-Dispatch ondemand trigger if configured (default True)
            auto_reply_messagekey = settings.get("auto_reply_messagekey", True)
            if auto_reply_messagekey:
                # Dispatch valid ondemand JSON query using received/live keys
                cm_dyn = str(LIVE_KEYS.get("CMKEY", "155521"))
                pm_dyn = str(LIVE_KEYS.get("PMKEY", "438266"))
                ondemand_auto_dict = build_ondemand_payload("3355", 0, cmkey=cm_dyn, pmkey=pm_dyn, cmd="read")
                auto_payload_str = json.dumps(ondemand_auto_dict)
                print(f">>> [AUTO-DISPATCH ONDEMAND] Handshake key received -> Sending dynamic JSON query to {target_topic} ...")
                state["last_dispatch_time"] = time.time()
                cli.publish(target_topic, auto_payload_str, qos=0)
            print("=" * 80)

        else:
            # Ondemand, Data, Heartbeat, or other response
            print("\n" + "=" * 80)
            badge = "[ONDEMAND DATA RECEIVED]" if "ondemand" in topic.lower() else "[DEVICE DATA RECEIVED]"
            print(f"{badge} Topic: {topic}")
            print(f"Timestamp : {datetime.now(timezone.utc).strftime('%Y-%m-%d %H:%M:%S')} UTC{rtt_str}")
            print("-" * 80)

            if parsed_dict and isinstance(parsed_dict, dict):
                print("Parsed Payload Breakdown (JSON):")
                for k, v in parsed_dict.items():
                    if k != "registers":
                        print(f"  {k:15}: {v}")
                if "registers" in parsed_dict:
                    print("  Registers / Metrics:")
                    for reg, val in parsed_dict["registers"].items():
                        print(f"    * Register [{reg}]: {val}")
            else:
                print("Raw Payload Content:")
                print(f"  {payload_str}")
            print("=" * 80)

        state["got_response"] = True

        if on_message_callback:
            try:
                on_message_callback(topic, payload_str, parsed_dict, is_rtevent)
            except Exception:
                pass

    sub_template = topics.get("ondemand_sub_template", f"rtsg-1/ongridrooftop/{primary_imei}/ondemand/sub")
    target_topic = sub_template.format(imei=primary_imei) if "{imei}" in sub_template else sub_template

    client.on_connect = on_connect
    client.on_message = on_message

    def on_disconnect(cli, userdata, *args):
        state["connected"] = False
        rc = args[1] if len(args) > 1 else (args[0] if args else 0)
        rc_code = rc if isinstance(rc, int) else getattr(rc, "value", rc)
        now_utc = datetime.now(timezone.utc).strftime("%H:%M:%S")
        if rc_code != 0:
            print(f"\n[!] [{now_utc} UTC] Disconnected from broker (Reason Code: {rc_code})")
            print("=" * 80)
            print("⚠️  WARNING: BROKER TERMINATED CONNECTION!")
            print(f"  Configured Client ID: '{client_id}'")
            print("  The MQTT broker allows only ONE active connection per Client ID.")
            print("  If MQTTBox is currently connected with this Client ID,")
            print("  the broker automatically kicks Python offline!")
            print("  👉 SOLUTION: Close or disconnect MQTTBox while running Python,")
            print("     OR set append_timestamp: true in config.yaml to allow simultaneous connections.")
            print("=" * 80 + "\n")

    client.on_disconnect = on_disconnect

    try:
        print(f"\n[*] Connecting to {host}:{port} (timeout: {connect_timeout}s) ...")
        client.connect(host, port, keepalive)
        client.loop_start()

        t0 = time.time()
        while not state["connected"] and (time.time() - t0) < connect_timeout:
            if stop_event and stop_event.is_set():
                break
            time.sleep(0.3)

        if not state["connected"]:
            print(f"[!] Connection timeout after {connect_timeout}s. Check network or credentials.")
            client.loop_stop()
            return

        if on_client_ready:
            on_client_ready(client)

        # Initial dispatch
        print(f"\n>>> [DISPATCHING INITIAL ONDEMAND FETCH] >>>")
        print(f"  Publish Topic : {target_topic}")
        print(f"  Payload Sent  : {payload_to_send}")
        state["last_dispatch_time"] = time.time()
        client.publish(target_topic, payload_to_send, qos=0)

        if once:
            timeout = settings.get("response_timeout_seconds", 30)
            wait_start = time.time()
            while not state["got_response"] and (time.time() - wait_start) < timeout:
                time.sleep(0.5)
        else:
            print(f"\n[+] Listening for target IMEI '{primary_imei}'.")
            print("--------------------------------------------------------------------------------")
            print("  [KEYBOARD SHORTCUT] Press [Enter] anytime to send Ondemand request JSON")
            print("  Type 'q' and press [Enter] to stop and disconnect.")
            print("--------------------------------------------------------------------------------\n")

            poll_interval = settings.get("poll_interval_seconds", 15)
            last_poll = time.time()

            # Interactive keyboard trigger thread
            def cli_input_worker():
                while not (stop_event and stop_event.is_set()):
                    try:
                        line = sys.stdin.readline()
                        if not line:
                            break
                        cmd = line.strip()
                        if cmd.lower() in ["q", "quit", "exit"]:
                            if stop_event:
                                stop_event.set()
                            break
                        else:
                            pay = cmd if cmd else payload_to_send
                            print(f"\n>>> [MANUAL ONDEMAND DISPATCH] >>> Topic: {target_topic} | Payload: '{pay}'")
                            state["last_dispatch_time"] = time.time()
                            client.publish(target_topic, pay, qos=0)
                    except Exception:
                        break

            if sys.stdin.isatty():
                in_thread = threading.Thread(target=cli_input_worker, daemon=True)
                in_thread.start()

            while True:
                if stop_event and stop_event.is_set():
                    break
                time.sleep(0.5)
                if settings.get("auto_poll", False) and (time.time() - last_poll) >= poll_interval:
                    client.publish(target_topic, payload_to_send, qos=0)
                    last_poll = time.time()

    except KeyboardInterrupt:
        print("\n[*] Stopping listener...")
    finally:
        client.loop_stop()
        client.disconnect()
        print("[*] Disconnected.")


# ==============================================================================
#                  BOXED TOPIC TRANSACTION LOGGER (START & OVER FRAMING)
# ==============================================================================

def format_boxed_log(header_title, fields_dict, width=82):
    """Generates a clean ascii/unicode framing box for topic transactions."""
    top_border = f"╔{'═' * (width - 2)}╗"
    mid_border = f"╟{'─' * (width - 2)}╢"
    bot_border = f"╚{'═' * (width - 2)}╝"

    lines = [top_border]
    hdr_content = f" {header_title} "
    lines.append(f"║{hdr_content.center(width - 2)}║")
    lines.append(mid_border)

    for key, val in fields_dict.items():
        val_str = str(val)
        prefix = f"║  • {key:<14}: "
        avail = width - len(prefix) - 2
        if len(val_str) <= avail:
            lines.append(f"{prefix}{val_str.ljust(avail)} ║")
        else:
            first_part = val_str[:avail]
            lines.append(f"{prefix}{first_part} ║")
            rest = val_str[avail:]
            indent = f"║    {' ' * 14}  "
            ind_avail = width - len(indent) - 2
            while rest:
                chunk = rest[:ind_avail]
                lines.append(f"{indent}{chunk.ljust(ind_avail)} ║")
                rest = rest[ind_avail:]

    lines.append(bot_border)
    return "\n".join(lines)


# ==============================================================================
#                  TKINTER GUI APPLICATION WITH ONDEMAND BUTTON & VIEWER
# ==============================================================================

def launch_gui(initial_config=None):
    """Launches the Tkinter Graphical Interface."""
    try:
        import tkinter as tk
        from tkinter import ttk, messagebox, scrolledtext
    except ImportError:
        print("[!] Error: Tkinter is not installed on this system.")
        return

    # Load persistent application session state
    saved_state = load_app_state()

    root = tk.Tk()
    root.title("MQTT SCADA & Ondemand Controller")
    try:
        root.state("zoomed")
    except Exception:
        root.geometry("1400x900")
    root.minsize(1080, 700)

    style = ttk.Style()
    style.theme_use("clam")

    current_config = initial_config or DEFAULT_CONFIG
    broker_cfg = current_config.get("broker", {})

    client_thread = None
    stop_event = threading.Event()
    is_connected = False
    active_client = None
    subscribed_topics_map = {}  # {topic: {"qos": qos, "packets": 0, "status": "Subscribed"}}
    last_dispatch_meta = {"topic": "", "payload": "", "time": 0, "time_str": ""}

    # Restore broker config from app_state if present
    init_host = saved_state.get("broker_host") or broker_cfg.get("host", "rms.iotscada-pmsg.com")
    init_port = str(saved_state.get("broker_port") or broker_cfg.get("port", 8883))
    init_user = saved_state.get("broker_user") or broker_cfg.get("username", "test")
    init_tls = saved_state.get("broker_use_tls", broker_cfg.get("use_tls", True))
    init_imei = saved_state.get("target_imei") or broker_cfg.get("name", "866738083619898")

    # =========================================================================
    # TOP HEADER: BROKER CONNECTION & CREDENTIALS
    # =========================================================================
    top_frame = ttk.LabelFrame(root, text="MQTT Broker Connection & Auto-Saved Credentials", padding=8)
    top_frame.pack(fill=tk.X, padx=10, pady=4)

    ttk.Label(top_frame, text="Host:").grid(row=0, column=0, sticky=tk.W, padx=3)
    entry_host = ttk.Entry(top_frame, width=22)
    entry_host.insert(0, init_host)
    entry_host.grid(row=0, column=1, padx=3)

    ttk.Label(top_frame, text="Port:").grid(row=0, column=2, sticky=tk.W, padx=3)
    entry_port = ttk.Entry(top_frame, width=6)
    entry_port.insert(0, init_port)
    entry_port.grid(row=0, column=3, padx=3)

    var_tls = tk.BooleanVar(value=init_tls)
    chk_tls = ttk.Checkbutton(top_frame, text="TLS/SSL", variable=var_tls)
    chk_tls.grid(row=0, column=4, padx=5)

    ttk.Label(top_frame, text="User:").grid(row=0, column=5, sticky=tk.W, padx=3)
    entry_user = ttk.Entry(top_frame, width=12)
    entry_user.insert(0, init_user)
    entry_user.grid(row=0, column=6, padx=3)

    ttk.Label(top_frame, text="Pass:").grid(row=0, column=7, sticky=tk.W, padx=3)
    entry_pass = ttk.Entry(top_frame, width=13, show="*")
    saved_pwd = get_saved_password(entry_host.get(), entry_user.get(), int(entry_port.get() or 8883))
    if saved_pwd:
        entry_pass.insert(0, saved_pwd)
    entry_pass.grid(row=0, column=8, padx=3)

    lbl_status = tk.Label(top_frame, text="● DISCONNECTED", fg="red", font=("Segoe UI", 9, "bold"))
    lbl_status.grid(row=0, column=10, padx=10)

    btn_connect = ttk.Button(top_frame, text="Connect")
    btn_connect.grid(row=0, column=9, padx=5)

    # =========================================================================
    # REGISTER DATA CACHE, SECTIONS & MAPPER
    # =========================================================================
    REGISTER_CACHE = {r["address"]: dict(r) for r in ALL_REGISTERS}
    NAME_TO_ADDR = {r["name"].upper(): r["address"] for r in ALL_REGISTERS}

    # Restore cached values from state if available
    cached_vals = saved_state.get("cached_register_values", {})
    if isinstance(cached_vals, dict):
        for addr_str, cdata in cached_vals.items():
            try:
                addr_int = int(addr_str)
                if addr_int in REGISTER_CACHE:
                    REGISTER_CACHE[addr_int]["value"] = cdata.get("value", "---")
                    REGISTER_CACHE[addr_int]["updated_at"] = cdata.get("updated_at", "Never")
            except (ValueError, TypeError):
                pass

    current_section = tk.StringVar(value=saved_state.get("selected_section", "1. GPRS_Connection"))

    # Notebook Tabs
    notebook = ttk.Notebook(root)
    notebook.pack(fill=tk.BOTH, expand=True, padx=10, pady=4)

    # -------------------------------------------------------------------------
    # TAB 1: MODBUS & GPRS REGISTER EXPLORER (3-CONTAINER UNIFIED SCADA CONTROL)
    # -------------------------------------------------------------------------
    tab_regs = ttk.Frame(notebook)
    notebook.add(tab_regs, text="  🔌 Modbus & GPRS Register Explorer  ")

    # =========================================================================
    # CONTAINER 1: TOP FULL-WIDTH REGISTER SEARCHBAR & SECTION SELECTOR
    # =========================================================================
    f_top_container = ttk.LabelFrame(tab_regs, text="1. Register Search Engine & Section Selector (Full-Width)", padding=6)
    f_top_container.pack(fill=tk.X, padx=8, pady=(2, 4))

    sec_btn_frame = ttk.Frame(f_top_container)
    sec_btn_frame.pack(fill=tk.X, pady=1)

    section_colors = {
        "1. GPRS_Connection": ("#e3f2fd", "#0d47a1"),
        "2. SPIFFS_Storage": ("#ffe0b2", "#e65100"),
        "3. Restart_Count": ("#ede7f6", "#4a148c"),
        "4. Solar_Power": ("#fff8e1", "#f57f17"),
        "5. Meters_DLMS": ("#e8f5e9", "#1b5e20"),
        "6. Control_Relays": ("#ffebee", "#b71c1c"),
        "7. System_RTC": ("#e0f2f1", "#004d40"),
        "8. All_Registers": ("#f5f5f5", "#212121"),
    }

    sec_buttons = {}
    wifi_sec_buttons = {}
    tree_wifi_regs = None

    def switch_section(sec_name):
        current_section.set(sec_name)
        if sec_name.startswith("8") or "ALL" in sec_name.upper():
            var_search_all.set(True)
        else:
            var_search_all.set(False)
        for btn_dict in (sec_buttons, wifi_sec_buttons):
            for name, btn in btn_dict.items():
                if name == sec_name:
                    btn.config(relief=tk.SUNKEN, bd=3)
                else:
                    btn.config(relief=tk.RAISED, bd=1)
        apply_filter_regs()

    for sec in SECTIONS:
        bg_col, fg_col = section_colors.get(sec, ("#f5f5f5", "#333"))
        is_cur = (sec == current_section.get())
        b = tk.Button(
            sec_btn_frame,
            text=sec,
            command=lambda s=sec: switch_section(s),
            bg=bg_col,
            fg=fg_col,
            font=("Segoe UI", 9, "bold" if is_cur else "normal"),
            relief=tk.SUNKEN if is_cur else tk.RAISED,
            bd=3 if is_cur else 1,
            padx=5,
            pady=2
        )
        b.pack(side=tk.LEFT, padx=2, pady=1)
        sec_buttons[sec] = b

    # Search & Filter Toolbar
    f_search = ttk.Frame(f_top_container)
    f_search.pack(fill=tk.X, pady=(3, 1))

    ttk.Label(f_search, text="🔍 Search Registers (Name/Addr/Function):", font=("Segoe UI", 9, "bold")).pack(side=tk.LEFT, padx=(2, 6))
    entry_reg_search = ttk.Entry(f_search, width=24, font=("Segoe UI", 9))
    entry_reg_search.insert(0, saved_state.get("search_query", ""))
    entry_reg_search.pack(side=tk.LEFT, padx=3)

    var_search_all = tk.BooleanVar(value=saved_state.get("search_all_sections", True))
    chk_search_all = ttk.Checkbutton(f_search, text="Search Across All Sections (Show Badges)", variable=var_search_all)
    chk_search_all.pack(side=tk.LEFT, padx=6)

    def clear_search():
        entry_reg_search.delete(0, tk.END)
        apply_filter_regs()

    btn_clear_s = ttk.Button(f_search, text="Clear Search", command=clear_search)
    btn_clear_s.pack(side=tk.LEFT, padx=3)

    lbl_reg_count = ttk.Label(f_search, text="Showing 0 registers", font=("Segoe UI", 9, "italic"))
    lbl_reg_count.pack(side=tk.RIGHT, padx=8)

    # =========================================================================
    # MAIN HORIZONTAL SPLIT (CONTAINER 2 LEFT ⇄ CONTAINER 3 RIGHT)
    # =========================================================================
    paned_main = ttk.PanedWindow(tab_regs, orient=tk.HORIZONTAL)
    paned_main.pack(fill=tk.BOTH, expand=True, padx=8, pady=(2, 4))

    # =========================================================================
    # CONTAINER 2: LEFT PANE - PUBLISH TOPIC, REGISTERS & PAYLOAD DISPATCH
    # =========================================================================
    f_left_container = ttk.LabelFrame(paned_main, text="2. Outgoing Command & Register Selector (Publish)", padding=6)
    paned_main.add(f_left_container, weight=3)

    # Row 0: Target IMEI & Publish Topic
    p_pub_header = ttk.Frame(f_left_container)
    p_pub_header.pack(fill=tk.X, pady=(1, 3))

    ttk.Label(p_pub_header, text="Target IMEI:").pack(side=tk.LEFT, padx=2)
    entry_imei_dyn = ttk.Entry(p_pub_header, width=17)
    entry_imei_dyn.insert(0, init_imei)
    entry_imei_dyn.pack(side=tk.LEFT, padx=2)

    ttk.Label(p_pub_header, text="Publish Topic:").pack(side=tk.LEFT, padx=(6, 2))
    entry_pub_topic_tab1 = ttk.Entry(p_pub_header, width=38, font=("Consolas", 8))
    entry_pub_topic_tab1.insert(0, f"rtsg-1/ongridrooftop/{init_imei}/ondemand/sub")
    entry_pub_topic_tab1.pack(side=tk.LEFT, fill=tk.X, expand=True, padx=2)

    def on_imei_changed(*args):
        imei_val = entry_imei_dyn.get().strip()
        if imei_val:
            entry_pub_topic_tab1.delete(0, tk.END)
            entry_pub_topic_tab1.insert(0, f"rtsg-1/ongridrooftop/{imei_val}/ondemand/sub")
            if 'entry_sub_imei_dyn' in locals() and entry_sub_imei_dyn.get().strip() != imei_val:
                entry_sub_imei_dyn.delete(0, tk.END)
                entry_sub_imei_dyn.insert(0, imei_val)
            if 'entry_sub_topic_tab1' in locals():
                entry_sub_topic_tab1.delete(0, tk.END)
                entry_sub_topic_tab1.insert(0, f"rtsg-1/ongridrooftop/{imei_val}/#")
            if len(imei_val) >= 10:
                set_dynamic_imei_topics(imei_val)
            update_payload_preview()

    entry_imei_dyn.bind("<KeyRelease>", on_imei_changed)

    # Row 0.5: Transport Mode Selector (Cloud MQTT Broker vs Local WiFi Direct)
    p_transport_header = ttk.Frame(f_left_container)
    p_transport_header.pack(fill=tk.X, pady=(1, 3))

    ttk.Label(p_transport_header, text="Channel:").pack(side=tk.LEFT, padx=(2, 2))
    var_transport_mode = tk.StringVar(value=saved_state.get("transport_mode", "mqtt"))
    rb_mqtt = ttk.Radiobutton(p_transport_header, text="Cloud MQTT Broker", variable=var_transport_mode, value="mqtt")
    rb_mqtt.pack(side=tk.LEFT, padx=3)
    rb_wifi = ttk.Radiobutton(p_transport_header, text="📶 Local WiFi Direct", variable=var_transport_mode, value="wifi")
    rb_wifi.pack(side=tk.LEFT, padx=3)

    lbl_wifi_quick_info = ttk.Label(
        p_transport_header,
        text=f"(Target: {saved_state.get('wifi_device_ip', '192.168.4.1')}:{saved_state.get('wifi_device_port', 80)})",
        font=("Consolas", 8, "italic"),
        foreground="#0d47a1"
    )
    lbl_wifi_quick_info.pack(side=tk.LEFT, padx=4)

    # Register Table (Treeview)
    reg_table_frame = ttk.Frame(f_left_container)
    reg_table_frame.pack(fill=tk.BOTH, expand=True, pady=2)

    reg_cols = ("Address", "Register Name", "Section / Category", "Current Value", "Description", "Last Updated")
    tree_regs = ttk.Treeview(reg_table_frame, columns=reg_cols, show="headings", selectmode="extended")

    tree_regs.heading("Address", text="Modbus Addr", anchor=tk.CENTER)
    tree_regs.heading("Register Name", text="Register Name", anchor=tk.W)
    tree_regs.heading("Section / Category", text="Section / Category", anchor=tk.CENTER)
    tree_regs.heading("Current Value", text="Current Value (Live)", anchor=tk.CENTER)
    tree_regs.heading("Description", text="Description / Firmware Function", anchor=tk.W)
    tree_regs.heading("Last Updated", text="Last Updated", anchor=tk.CENTER)

    tree_regs.column("Address", width=85, anchor=tk.CENTER)
    tree_regs.column("Register Name", width=170, anchor=tk.W)
    tree_regs.column("Section / Category", width=130, anchor=tk.CENTER)
    tree_regs.column("Current Value", width=120, anchor=tk.CENTER)
    tree_regs.column("Description", width=250, anchor=tk.W)
    tree_regs.column("Last Updated", width=105, anchor=tk.CENTER)

    tree_regs.tag_configure("updated", background="#e8f5e9", foreground="#1b5e20")
    tree_regs.tag_configure("normal", background="#ffffff")

    reg_scroll_y = ttk.Scrollbar(reg_table_frame, orient=tk.VERTICAL, command=tree_regs.yview)
